-- THEME SETTER
------------------------------------------------------------
function MozCraft:SetTheme(name)
	local t = Themes[name]
	if not t then return end
	currentTheme = t
	applyGradient(topBandGrad, t[1], t[2])
	applyGradient(tabHlGrad,   t[1], t[2])
	tabHighlight.BackgroundColor3 = t[1]
end

