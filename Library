-- ║   CENTER HELPER          ║
-- ║  Respects UIScale        ║
-- ╚══════════════════════════╝
local function centerWindow()
	local vp = ScreenGui.AbsoluteSize
	local sc = uiScale.Scale
	local sw = BASE_W * sc
	local sh = BASE_H * sc
	local nx = math.clamp((vp.X - sw) * 0.5, 0, math.max(0, vp.X - sw))
	local ny = math.clamp((vp.Y - sh) * 0.5, 0, math.max(0, vp.Y - sh))
	mainWindow.Position = UDim2.new(0, nx, 0, ny)
end

-- Clamp current position inside screen bounds
local function clampWindow()
	if not mainWindow.Visible then return end
	local vp  = ScreenGui.AbsoluteSize
	local ws  = mainWindow.AbsoluteSize
	local pos = mainWindow.AbsolutePosition
	local nx  = math.clamp(pos.X, 0, math.max(0, vp.X - ws.X))
	local ny  = math.clamp(pos.Y, 0, math.max(0, vp.Y - ws.Y))
	mainWindow.Position = UDim2.new(0, nx, 0, ny)
end

