-- ║  PUBLIC NOTIFY METHOD    ║
-- ╚══════════════════════════╝
function MozCraft:Notify(opts)
	opts = opts or {}
	notify(
		opts.Title    or "Notification",
		opts.Content  or "",
		opts.Type     or "info",
		opts.Duration or 3.5
	)
end

-- ╔══════════════════════════╗
-- ║      SEARCH SYSTEM       ║
-- ║  Instant clear           ║
-- ║  No debounce on backspace║
-- ║  All tabs simultaneously ║
-- ╚══════════════════════════╝
local lastQuery = ""

local function applySearch(query)
	query = query:lower()
	if query == lastQuery then return end
	lastQuery   = query
	local empty = (query == "")

	for _, page in pairs(pages) do
		for _, child in ipairs(page:GetChildren()) do
			if child:IsA("TextButton") then
				child.Visible = empty or (child.Name:lower():find(query, 1, true) ~= nil)
			end
		end
	end
end

searchBox:GetPropertyChangedSignal("Text"):Connect(function()
	local q = searchBox.Text
	-- Instant clear with no debounce
	if q == "" then
		applySearch("")
		return
	end
	-- Instant filter — no debounce delay per spec
	applySearch(q)
end)

-- ╔══════════════════════════╗
-- ║    KEYBOARD SHORTCUTS    ║
-- ╚══════════════════════════╝
trackConn(UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.I then
		if windowOpen then closeWindow() else openWindow() end
	elseif input.KeyCode == Enum.KeyCode.Escape and windowOpen then
		closeWindow()
	end
end))

-- ╔══════════════════════════╗
-- ║   HOLD-TO-CLOSE (5s)     ║
-- ╚══════════════════════════╝
local holdActive    = false
local HOLD_TIME     = 5
local holdRingTween = nil

local function cancelHold()
	holdActive = false
	if holdRingTween then
		pcall(function() holdRingTween:Cancel() end)
		holdRingTween = nil
	end
	safeTween(holdRing, TI.hover, {BackgroundTransparency = 1})
end

toggleBtn.MouseButton1Down:Connect(function()
	cancelHold()
	holdActive = true
	local startTick = tick()
	holdRingTween = safeTween(holdRing,
		TweenInfo.new(HOLD_TIME, Enum.EasingStyle.Linear),
		{BackgroundTransparency = 0.5}
	)
	task.spawn(function()
		while holdActive do
			if tick() - startTick >= HOLD_TIME then
				cancelHold()
				showConfirm()
				break
			end
			task.wait(0.05)
		end
	end)
end)

trackConn(UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		if holdActive then cancelHold() end
	end
end))

