-- ╔══════════════════════════╗
-- ║   SCALE CALCULATION      ║
-- ║  Only scale down when    ║
-- ║  screen physically can't ║
-- ║  fit the window          ║
-- ╚══════════════════════════╝
local function computeScale()
	local vp = workspace.CurrentCamera.ViewportSize
	-- Only scale down if screen is smaller than window + some margin
	local scaleX = math.min(1, (vp.X - 20) / BASE_W)
	local scaleY = math.min(1, (vp.Y - 20) / BASE_H)
	return math.floor(math.min(scaleX, scaleY) * 100) / 100  -- round to 2dp
end

local function applyScale()
	uiScale.Scale = computeScale()
end

