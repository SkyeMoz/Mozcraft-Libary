-- ║  TAB HIGHLIGHT — FIXED   ║
-- ║  Waits 1 frame so sizes  ║
-- ║  are fully computed      ║
-- ╚══════════════════════════╝
local function repositionHighlight(name)
	if not name then return end
	local targetBtn = tabButtons[name]
	if not targetBtn then return end
	-- Use task.defer to ensure layout has resolved button sizes
	task.defer(function()
		if not targetBtn or not targetBtn.Parent then return end
		if not tabBarContainer or not tabBarContainer.Parent then return end
		-- Relative X within the tabBarContainer (not tabScroll, which can be scrolled)
		local barAbsX = tabBarContainer.AbsolutePosition.X
		local btnAbsX = targetBtn.AbsolutePosition.X
		local relX    = btnAbsX - barAbsX
		local btnW    = targetBtn.AbsoluteSize.X
		safeTween(tabHighlight, TI.tab, {
			Position = UDim2.new(0, relX, 0, 2),
			Size     = UDim2.new(0, btnW, 1, -4),
		})
	end)
end

