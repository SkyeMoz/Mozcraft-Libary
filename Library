local IS_DESKTOP = not UserInputService.TouchEnabled or UserInputService.MouseEnabled

local tooltipFrame = makeFrame{
	Name                   = "Tooltip",
	Size                   = UDim2.new(0, 120, 0, 22),
	BackgroundColor3       = THEME.BG_ELEVATED,
	BackgroundTransparency = 0.1,
	Visible                = false,
