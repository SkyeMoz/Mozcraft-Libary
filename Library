end

------------------------------------------------------------
-- TAB SWITCHING
------------------------------------------------------------
local function switchTab(name)
	activeTab = name
	emptyLabel.Visible = false

	for n, page in pairs(pages) do
		page.Visible = (n == name)
	end

	-- slide highlight
	local btn = tabBtns[name]
	if btn then
		local targetX = btn.Position.X.Offset
		tween(tabHighlight, 0.18, {
			Position = UDim2.new(0, targetX - 2, 0, 2),
			Size     = UDim2.new(0, btn.AbsoluteSize.X + 4, 0, 26)
		}, Enum.EasingStyle.Sine):Play()
	end
end

------------------------------------------------------------
-- CREATE TAB
------------------------------------------------------------
function MozCraft:createTab(name)
	if pages[name] then return end

	-- Tab button
	local btn = Instance.new("TextButton")
	btn.Text = name
	btn.AutomaticSize = Enum.AutomaticSize.X
	btn.Size = UDim2.new(0,0,0,26)
	btn.BackgroundTransparency = 1
	btn.TextColor3 = Color3.fromRGB(140,140,155)
	btn.Font = Enum.Font.GothamSemibold
	btn.TextSize = 12
	btn.ZIndex = 8
	btn.Parent = tabScroll
	local btnPad = Instance.new("UIPadding")
	btnPad.PaddingLeft  = UDim.new(0,10)
	btnPad.PaddingRight = UDim.new(0,10)
	btnPad.Parent = btn

	tabBtns[name] = btn

	-- Content page
	local page = Instance.new("ScrollingFrame")
	page.Size = UDim2.new(1,0,1,0)
	page.CanvasSize = UDim2.new(0,0,0,0)
	page.ScrollBarThickness = 3
	page.ScrollBarImageColor3 = Color3.fromRGB(80,80,90)
	page.BackgroundTransparency = 1
	page.Visible = false
	page.ZIndex = 5
	page.Parent = contentArea

	local grid = Instance.new("UIGridLayout")
	grid.CellSize    = UDim2.new(0,82,0,86)
	grid.CellPadding = UDim2.new(0,8,0,8)
	grid.SortOrder   = Enum.SortOrder.LayoutOrder
	grid.Parent = page

	local gridPad = Instance.new("UIPadding")
	gridPad.PaddingTop    = UDim.new(0,6)
	gridPad.PaddingLeft   = UDim.new(0,2)
	gridPad.Parent = page

	grid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		page.CanvasSize = UDim2.new(0,0,0,grid.AbsoluteContentSize.Y + 16)
	end)

	btn.MouseButton1Click:Connect(function()
		playClick()
		switchTab(name)
		tween(btn, 0.1, {TextColor3 = Color3.fromRGB(255,255,255)}):Play()
		-- dim others
		for n, b in pairs(tabBtns) do
			if n ~= name then
				tween(b, 0.1, {TextColor3 = Color3.fromRGB(140,140,155)}):Play()
			end
		end
	end)

	pages[name] = page

	-- Update scroll canvas
	task.defer(function()
		tabScroll.CanvasSize = UDim2.new(0, tabLayout.AbsoluteContentSize.X + 16, 0, 0)
	end)

	-- Auto-select first tab
	if activeTab == nil then
		task.defer(function() switchTab(name) end)
	end
end

