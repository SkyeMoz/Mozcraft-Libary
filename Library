-- ═══════════════════════════════════════════════
--  DEVICE DETECTION
-- ═══════════════════════════════════════════════
local function getDeviceType()
    local camera = workspace.CurrentCamera
    local vp = camera and camera.ViewportSize or Vector2.new(1920, 1080)
    if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
        if vp.X < 600 then return "phone"
        else return "tablet" end
    elseif vp.X < 1024 then return "tablet"
    else return "desktop" end
end

local deviceType = getDeviceType()
local isMobile   = deviceType == "phone" or deviceType == "tablet"

-- Responsive values
local R = {}
local function updateResponsive()
    local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920,1080)
    deviceType = getDeviceType()
    isMobile   = deviceType == "phone" or deviceType == "tablet"
    if deviceType == "phone" then
        R.INV_W_SCALE  = 0.90
        R.INV_H_SCALE  = 0.80
        R.TAB_W        = 38
        R.SLOT_SZ      = 30
        R.SLOT_PAD     = 2
        R.SEARCH_H     = 26
        R.FONT_SIZE    = 11
        R.ICON_SZ      = 22
    elseif deviceType == "tablet" then
        R.INV_W_SCALE  = 0.82
        R.INV_H_SCALE  = 0.78
        R.TAB_W        = 42
        R.SLOT_SZ      = 34
        R.SLOT_PAD     = 2
        R.SEARCH_H     = 28
        R.FONT_SIZE    = 12
        R.ICON_SZ      = 26
    else
        R.INV_W_SCALE  = 0.70
        R.INV_H_SCALE  = 0.75
        R.TAB_W        = 48
        R.SLOT_SZ      = 40
        R.SLOT_PAD     = 3
        R.SEARCH_H     = 30
        R.FONT_SIZE    = 13
        R.ICON_SZ      = 30
    end
    R.VP_W = vp.X
    R.VP_H = vp.Y
    R.INV_W = math.floor(vp.X * R.INV_W_SCALE)
    R.INV_H = math.floor(vp.Y * R.INV_H_SCALE)
end
updateResponsive()

