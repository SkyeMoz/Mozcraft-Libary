-- ╔══════════════════════════╗
-- ║       CREATE TAB         ║
-- ╚══════════════════════════╝
function MozCraft:createTab(name)
	if pages[name] then return end

	tabCounts[name] = 0

	-- Tab button
	local btn = makeButton{
		Name             = "Tab_" .. name,
		Text             = name .. " ",
		Size             = UDim2.new(0, 0, 1, -6),
		BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BackgroundTransparency = 1,
		TextColor3       = THEME.TEXT_SECONDARY,
		Font             = Enum.Font.GothamSemibold,
		TextSize         = 12,
		AutomaticSize    = Enum.AutomaticSize.X,
		ZIndex           = 9,
		Parent           = tabScroll,
	}
	corner(btn, 8)
	padding(btn, 0, 10, 0, 10)

	-- counter badge
	local badge = makeLabel{
		Name         = "CountBadge",
		Size         = UDim2.new(0, 18, 0, 16),
		Position     = UDim2.new(1, -20, 0.5, -8),
		Text         = "0",
		TextColor3   = THEME.TEXT_MUTED,
		Font         = Enum.Font.GothamBold,
		TextSize     = 10,
		ZIndex       = 10,
		Parent       = btn,
	}

	-- Content page
	local page = Instance.new("ScrollingFrame")
	page.Name                  = "Page_" .. name
	page.Size                  = UDim2.new(1, 0, 1, 0)
	page.CanvasSize            = UDim2.new(0, 0, 0, 0)
	page.AutomaticCanvasSize   = Enum.AutomaticSize.Y
	page.ScrollBarThickness    = 4
	page.ScrollBarImageColor3  = THEME.ACCENT
	page.BackgroundTransparency = 1
	page.Visible               = false
	page.ZIndex                = 8
	page.Parent                = contentHolder

	local grid = Instance.new("UIGridLayout")
	grid.CellSize    = UDim2.new(0, 96, 0, 96)
	grid.CellPadding = UDim2.new(0, 8, 0, 8)
	grid.SortOrder   = Enum.SortOrder.Name
	grid.Parent      = page
	padding(page, 4, 4, 8, 4)

	-- Click handler
	btn.MouseButton1Click:Connect(function()
		playSound(SND.click)
		MozCraft:selectTab(name)
	end)

	-- Hover
	btn.MouseEnter:Connect(function()
		if tabButtons[name] ~= btn or btn.TextColor3 == THEME.TEXT_PRIMARY then return end
		tween(btn, TWEEN_FAST, {TextColor3 = Color3.fromRGB(200, 200, 210)})
	end)
	btn.MouseLeave:Connect(function()
		if btn.TextColor3 == THEME.TEXT_PRIMARY then return end
		tween(btn, TWEEN_FAST, {TextColor3 = THEME.TEXT_SECONDARY})
	end)

	pages[name]      = page
	tabButtons[name] = btn

	-- Update canvas width
	task.defer(function()
		tabScroll.CanvasSize = UDim2.new(0, tabLayout.AbsoluteContentSize.X + 10, 0, 0)
	end)
end

-- ╔══════════════════════════╗
-- ║       SELECT TAB         ║
-- ╚══════════════════════════╝
local currentTab = nil

function MozCraft:selectTab(name)
	if not pages[name] then return end

	emptyState.Visible = false

	-- hide all pages
	for _, p in pairs(pages) do
		p.Visible = false
	end

	-- deselect all buttons
	for _, b in pairs(tabButtons) do
		tween(b, TWEEN_FAST, {TextColor3 = THEME.TEXT_SECONDARY})
	end

	-- show selected
	pages[name].Visible = true
	tween(tabButtons[name], TWEEN_FAST, {TextColor3 = THEME.TEXT_PRIMARY})

	-- Animate highlight pill
	local targetBtn = tabButtons[name]
	local btnAbsPos = targetBtn.AbsolutePosition
	local barAbsPos = tabBarContainer.AbsolutePosition
	local relX      = btnAbsPos.X - barAbsPos.X

	tween(tabHighlight, TWEEN_MED, {
		Position = UDim2.new(0, relX, 0, 3),
		Size     = UDim2.new(0, targetBtn.AbsoluteSize.X, 1, -6),
	})

	currentTab = name

	-- Page fade-in
	pages[name].BackgroundTransparency = 1
	tween(pages[name], TWEEN_FAST, {BackgroundTransparency = 1}) -- pages are transparent
end

