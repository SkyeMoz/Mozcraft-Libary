function MozCraft:createTab(data)
    local name, iconId, isSettings

    if type(data) == "string" then
        name = data
        iconId = nil
        isSettings = false
    else
        name       = data.Name or data
        iconId     = data.Icon
        isSettings = data.Settings or false
    end

    if tabs[name] then return tabs[name] end

    local order = #tabOrder + 1
    table.insert(tabOrder, name)

    -- Tab button
    local btn = makeButton(tabScrollFrame,
        UDim2.new(0, R.TAB_W - 6, 0, R.TAB_W - 6),
        UDim2.new(0, 0, 0, 0),
        C.PANEL, 7)
    btn.Name        = name.."_Tab"
    btn.LayoutOrder = order

    -- Icon image (preferred) or emoji/letter fallback
    if iconId then
        local img = makeImage(btn, iconId,
            UDim2.new(0, R.ICON_SZ - 6, 0, R.ICON_SZ - 6),
            UDim2.new(0.5, -(R.ICON_SZ-6)/2, 0.5, -(R.ICON_SZ-6)/2), 8)
        img.Name = "TabIcon"
    else
        -- emoji / text fallback
        local emoji = "?"
        if string.find(name, "Favorites") or name == "★" then emoji = "★"
        elseif string.find(name, "Settings") then emoji = "⚙"
        elseif string.find(name, "Block") then emoji = "⬛"
        elseif string.find(name, "Item") then emoji = "🎒"
        elseif string.find(name, "Info") then emoji = "📄"
        end
        local lbl = makeLabel(btn, emoji,
            UDim2.new(1,0,1,0), UDim2.new(0,0,0,0),
            FONT, 16, C.TEXT_WHITE, Enum.TextXAlignment.Center, 8)
        lbl.Name = "TabIcon"
    end

    -- Bevel frames
    local bvTL = makeFrame(btn, UDim2.new(1,0,0,2), UDim2.new(0,0,0,0), C.LIGHT, 8)
    bvTL.Name = "BevTL"
    bvTL.BackgroundTransparency = 0.35
    local bvL  = makeFrame(btn, UDim2.new(0,2,1,0), UDim2.new(0,0,0,0), C.LIGHT, 8)
    bvL.BackgroundTransparency  = 0.35
    local bvBR = makeFrame(btn, UDim2.new(1,0,0,2), UDim2.new(0,0,1,-2), C.DARK, 8)
    bvBR.Name = "BevBR"
    local bvR  = makeFrame(btn, UDim2.new(0,2,1,0), UDim2.new(1,-2,0,0), C.DARK, 8)

    -- Category name tooltip
    local catTip = makeFrame(guiRoot,
        UDim2.new(0, math.max(#name*7+12, 60), 0, 22),
        UDim2.new(0, 0, 0, 0),
        C.TOOLTIP_BG, 50)
    catTip.Visible = false
    catTip.BackgroundTransparency = 0.1
    Instance.new("UIStroke", catTip).Color = C.TOOLTIP_BRD
    local catLbl = makeLabel(catTip, name,
        UDim2.new(1,-8,1,0), UDim2.new(0,4,0,0),
        FONT, 11, C.TEXT_WHITE, Enum.TextXAlignment.Left, 51)

    btn.MouseEnter:Connect(function()
        if currentTab ~= name then
            TweenService:Create(btn, TWEEN_FAST, {BackgroundColor3 = Color3.fromRGB(160,160,160)}):Play()
        end
        local absPos = btn.AbsolutePosition
        catTip.Position = UDim2.new(0, absPos.X + R.TAB_W + 4, 0, absPos.Y + 2)
        catTip.Visible  = not isMobile
    end)
    btn.MouseLeave:Connect(function()
        if currentTab ~= name then
            TweenService:Create(btn, TWEEN_FAST, {BackgroundColor3 = C.PANEL}):Play()
        end
        catTip.Visible = false
    end)
    btn.MouseButton1Down:Connect(function()
        btn.Position = UDim2.new(0, 1, 0, 0)
    end)
    btn.MouseButton1Up:Connect(function()
        btn.Position = UDim2.new(0, 0, 0, 0)
    end)
    btn.MouseButton1Click:Connect(function()
        safePlay(sndClick)
        catTip.Visible = false
        selectTab(name)
    end)

    tabs[name] = {
        btn        = btn,
        isSettings = isSettings,
        order      = order,
        elements   = {},
    }

    return tabs[name]
end

