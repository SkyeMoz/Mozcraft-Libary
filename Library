    local state = (data.Default == true)
    local frame = makeSettingsContainer(tabName)
    makeLabel(frame, data.Name or "Toggle",
        UDim2.new(0.7,0,1,0), UDim2.new(0,8,0,0),
        FONT, R.FONT_SIZE, C.TEXT_WHITE, Enum.TextXAlignment.Left, 7)

    local trackW, trackH = 42, 20
    local track = makeButton(frame,
        UDim2.new(0, trackW, 0, trackH),
        UDim2.new(1, -trackW-6, 0.5, -trackH/2),
        state and C.TOGGLE_ON or C.TOGGLE_OFF, 7)
    addCornerRadius(track, 10)

    local knob = makeFrame(track,
        UDim2.new(0, trackH-4, 0, trackH-4),
        UDim2.new(0, state and trackW-trackH+2 or 2, 0.5, -(trackH-4)/2),
        C.LIGHT, 8)
    addCornerRadius(knob, trackH)

    local function setToggle(v, fireCallback)
        state = v
        TweenService:Create(track, TWEEN_MED, {BackgroundColor3 = v and C.TOGGLE_ON or C.TOGGLE_OFF}):Play()
        TweenService:Create(knob, TWEEN_MED, {
            Position = UDim2.new(0, v and trackW-trackH+2 or 2, 0.5, -(trackH-4)/2)
        }):Play()
        if fireCallback and type(data.Callback) == "function" then
            pcall(data.Callback, v)
        end
    end

    track.MouseButton1Click:Connect(function()
        safePlay(sndClick)
        setToggle(not state, true)
    end)

    if data.Default then setToggle(true, false) end
end

function MozCraft:createSlider(data)
    local tabName = data.Tab or "Settings"
    if not tabs[tabName] then
        self:createTab({ Name = tabName, Settings = true })
    end

    local min, max, step = data.Min or 0, data.Max or 100, data.Step or 1
    local val = data.Default or min

    local frame = makeFrame(settingsList,
        UDim2.new(1,0,0,48),
        UDim2.new(0,0,0,0),
        C.SLOT, 6)
    frame:SetAttribute("Tab", tabName)
    addRaisedBevel(frame, 7)

    makeLabel(frame, data.Name or "Slider",
        UDim2.new(0.6,0,0,18), UDim2.new(0,8,0,0),
        FONT, R.FONT_SIZE, C.TEXT_WHITE, Enum.TextXAlignment.Left, 7)

    local valLabel = makeLabel(frame, tostring(val),
        UDim2.new(0,40,0,18), UDim2.new(1,-44,0,0),
        FONT, R.FONT_SIZE, C.TEXT_WHITE, Enum.TextXAlignment.Right, 7)

    local TRACK_PAD = 8
    local trackBg = makeFrame(frame,
        UDim2.new(1,-TRACK_PAD*2,0,8),
        UDim2.new(0,TRACK_PAD,0,28),
        C.SLIDER_BG, 7)
    addInsetBevel(trackBg, 8)

    local fill = makeFrame(trackBg,
        UDim2.new((val-min)/(max-min),0,1,0),
        UDim2.new(0,0,0,0),
        C.SLIDER_FILL, 8)

    local knob = makeFrame(trackBg,
        UDim2.new(0,12,0,12),
        UDim2.new((val-min)/(max-min),0-6,0.5,-6),
        C.LIGHT, 9)
    addCornerRadius(knob, 6)

    local draggingSlider = false
    local function setVal(pct)
        pct = math.clamp(pct, 0, 1)
        val = math.floor((min + (max-min)*pct)/step + 0.5) * step
        val = math.clamp(val, min, max)
        local p = (val-min)/(max-min)
        fill.Size     = UDim2.new(p,0,1,0)
        knob.Position = UDim2.new(p,-6,0.5,-6)
        valLabel.Text = tostring(val)
        if type(data.Callback) == "function" then pcall(data.Callback, val) end
    end

    trackBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true
            local rel = input.Position.X - trackBg.AbsolutePosition.X
            setVal(rel / trackBg.AbsoluteSize.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local rel = input.Position.X - trackBg.AbsolutePosition.X
            setVal(rel / trackBg.AbsoluteSize.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = false
        end
    end)
end

