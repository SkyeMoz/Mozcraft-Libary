------------------------------------------------------------
-- MOBILE SCALE (keep same visual size on any screen)
------------------------------------------------------------
task.defer(function()
	local vp = workspace.CurrentCamera.ViewportSize
	-- If screen width < 600 (mobile), scale down slightly but keep proportions
	if vp.X < 600 then
		local scale = math.clamp(vp.X / 420, 0.7, 1)
		main.Size = UDim2.new(0, WINDOW_W*scale, 0, WINDOW_H*scale)
		main.Position = UDim2.new(0.5, -(WINDOW_W*scale)/2, 0.5, -(WINDOW_H*scale)/2)
	end
end)

return MozCraft
