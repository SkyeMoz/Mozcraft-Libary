stroke(tooltipFrame, THEME.BORDER, 1, 0.3)

local tooltipLabel = makeLabel{
	Size       = UDim2.new(1, -10, 1, 0),
	Position   = UDim2.new(0, 5, 0, 0),
	TextColor3 = THEME.TEXT_PRIMARY,
	TextSize   = 10,
	ZIndex     = 201,
	Parent     = tooltipFrame,
}

local tooltipActive = false
local tooltipHB     = nil
local tooltipConns  = {}

local function startTooltipHB()
	if tooltipHB then return end
	tooltipHB = RunService.Heartbeat:Connect(function()
		if not tooltipActive then tooltipHB:Disconnect(); tooltipHB = nil; return end
		local mp = UserInputService:GetMouseLocation()
		tooltipFrame.Position = UDim2.new(0, mp.X + 10, 0, mp.Y - 28)
	end)
end

local function showTooltip(text)
	if not IS_DESKTOP then return end
	tooltipLabel.Text = text
	local ok, ts = pcall(TextService.GetTextSize, TextService, text, 10, Enum.Font.Gotham, Vector2.new(400, 22))
	tooltipFrame.Size    = UDim2.new(0, (ok and ts) and (ts.X + 10) or 110, 0, 22)
	tooltipFrame.Visible = true
	tooltipActive        = true
	startTooltipHB()
end

local function hideTooltip()
	tooltipActive        = false
	tooltipFrame.Visible = false
end

local function addTooltip(obj, getText)
	if not IS_DESKTOP then return end
	local function resolve()
		return type(getText) == "function" and getText() or getText
	end
	local prev = tooltipConns[obj]
	if prev then
		pcall(function() prev[1]:Disconnect() end)
		pcall(function() prev[2]:Disconnect() end)
	end
	local ec, lc
	pcall(function() ec = obj.MouseEnter:Connect(function() showTooltip(resolve()) end) end)
	pcall(function() lc = obj.MouseLeave:Connect(function() hideTooltip() end) end)
	tooltipConns[obj] = {ec, lc}
end

local function removeTooltip(obj)
	local prev = tooltipConns[obj]
	if not prev then return end
	pcall(function() prev[1]:Disconnect() end)
	pcall(function() prev[2]:Disconnect() end)
	tooltipConns[obj] = nil
end

-- ╔══════════════════════════╗
-- ║   RIPPLE CLICK EFFECT    ║
-- ╚══════════════════════════╝
local function addRipple(button, color)
	color = color or Color3.fromRGB(255, 255, 255)
	button.ClipsDescendants = true
	button.MouseButton1Down:Connect(function()
		local mp  = UserInputService:GetMouseLocation()
		local abs = button.AbsolutePosition
		local rip = Instance.new("Frame")
		rip.Size                   = UDim2.new(0, 0, 0, 0)
		rip.Position               = UDim2.new(0, mp.X - abs.X, 0, mp.Y - abs.Y)
		rip.AnchorPoint            = Vector2.new(0.5, 0.5)
		rip.BackgroundColor3       = color
		rip.BackgroundTransparency = 0.75
		rip.ZIndex                 = button.ZIndex + 1
		rip.Parent                 = button
		corner(rip, 999)
		local maxSize = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 2.2
		safeTween(rip, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, maxSize, 0, maxSize), BackgroundTransparency = 1,
		})
		game:GetService("Debris"):AddItem(rip, 0.4)
	end)
end

