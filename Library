-- ╔══════════════════════════╗
-- ║       CREATE SLOT        ║
-- ╚══════════════════════════╝
function MozCraft:createSlot(data)
	if not pages[data.Tab] then self:createTab(data.Tab) end

	-- Store data reference for search rebuilding
	slotData[data.Name] = data

	-- Update counters
	if data.Tab ~= "Favorites ⭐" then
		tabCounts[data.Tab] = (tabCounts[data.Tab] or 0) + 1
		updateTabCounter(data.Tab)
	end

	-- ── inner builder ──────────────────────────────────────────
	local function buildSlot(parentPage, isFavPage)
		local slot = makeButton{
			Name             = data.Name,
			Size             = UDim2.new(0, 96, 0, 96),
			BackgroundColor3 = THEME.BG_CARD,
			Text             = "",
			ZIndex           = 9,
			Parent           = parentPage,
		}
		corner(slot, 12)
		stroke(slot, THEME.BORDER, 1, 0.4)
		addRipple(slot, THEME.ACCENT)

		-- gradient bg
		local slotGrad = gradient(slot, ColorSequence.new{
			ColorSequenceKeypoint.new(0, Color3.fromRGB(28, 28, 36)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(18, 18, 24)),
		}, 135)

		-- icon
		local icon = Instance.new("ImageLabel")
		icon.Size                = UDim2.new(0, 52, 0, 52)
		icon.Position            = UDim2.new(0.5, -26, 0, 8)
		icon.BackgroundTransparency = 1
		icon.Image               = "rbxassetid://" .. tostring(data.Icon)
		icon.ZIndex              = 10
		icon.Parent              = slot

		-- fallback if icon fails
		icon:GetPropertyChangedSignal("IsLoaded"):Connect(function()
			if not icon.IsLoaded then
				icon.Image = "rbxassetid://3959438440" -- fallback placeholder
			end
		end)

		-- label
		local label = makeLabel{
			Size           = UDim2.new(1, -4, 0, 18),
			Position       = UDim2.new(0, 2, 1, -22),
			Text           = data.Name,
			TextColor3     = THEME.TEXT_SECONDARY,
			Font           = Enum.Font.Gotham,
			TextSize       = 11,
			TextTruncate   = Enum.TextTruncate.AtEnd,
			ZIndex         = 10,
			Parent         = slot,
		}

		-- star button
		local isFav = favorites[data.Name] == true
		local star = makeButton{
			Name         = "StarBtn",
			Size         = UDim2.new(0, 20, 0, 20),
			Position     = UDim2.new(1, -22, 0, 2),
			Text         = isFav and "★" or "☆",
			TextColor3   = isFav and THEME.STAR or THEME.TEXT_MUTED,
			TextSize     = 14,
			Font         = Enum.Font.GothamBold,
			ZIndex       = 11,
			Parent       = slot,
		}

		-- status dot (execution state)
		local statusDot = makeFrame{
			Size             = UDim2.new(0, 6, 0, 6),
			Position         = UDim2.new(0, 4, 0, 4),
			BackgroundColor3 = THEME.TEXT_MUTED,
			ZIndex           = 11,
			Parent           = slot,
		}
		corner(statusDot, 3)

		addTooltip(slot,  data.Name .. (data.Logic == "Copy" and " — Click to Copy" or " — Click to Execute"))
		addTooltip(star,  isFav and "Remove from Favorites" or "Add to Favorites")

		-- Hover effects
		slot.MouseEnter:Connect(function()
			tween(slot, TWEEN_FAST, {BackgroundColor3 = THEME.BG_ELEVATED})
			tween(label, TWEEN_FAST, {TextColor3 = THEME.TEXT_PRIMARY})
		end)
		slot.MouseLeave:Connect(function()
			tween(slot, TWEEN_FAST, {BackgroundColor3 = THEME.BG_CARD})
			tween(label, TWEEN_FAST, {TextColor3 = THEME.TEXT_SECONDARY})
		end)

		-- ── EXECUTE ───────────────────────────────────────────
		slot.MouseButton1Click:Connect(function()
			playSound(SND.click)
			recordHistory(data.Name, data.Logic)

			-- Status: running
			tween(statusDot, TWEEN_FAST, {BackgroundColor3 = THEME.ACCENT})
			startSpinner(UDim2.new(
				slot.AbsolutePosition.X / ScreenGui.AbsoluteSize.X,
				0,
				slot.AbsolutePosition.Y / ScreenGui.AbsoluteSize.Y,
				0
			))

			task.spawn(function()
				local ok, err
				if data.Logic == "Execute" then
					ok, err = pcall(function()
						loadstring(game:HttpGet(data.Script))()
					end)
				elseif data.Logic == "Copy" then
					ok, err = pcall(function()
						if setclipboard then
							setclipboard(data.Script)
						end
					end)
				end

				stopSpinner()

				if ok then
					tween(statusDot, TWEEN_FAST, {BackgroundColor3 = THEME.SUCCESS})
					notify(
						data.Logic == "Copy" and "Copied!" or "Executed",
						data.Name,
						"success"
					)
				else
					tween(statusDot, TWEEN_FAST, {BackgroundColor3 = THEME.ERROR})
					notify("Error", tostring(err):sub(1, 80), "error")
				end

				task.wait(2.5)
				tween(statusDot, TWEEN_SLOW, {BackgroundColor3 = THEME.TEXT_MUTED})
			end)
		end)

		-- ── STAR TOGGLE ────────────────────────────────────────
		star.MouseButton1Click:Connect(function()
			playSound(SND.star)
			favorites[data.Name] = not favorites[data.Name]
			saveFavorites()

			-- Update ALL stars for this slot across all pages
			for _, pg in pairs(pages) do
				local s = pg:FindFirstChild(data.Name)
				if s then
					local sb = s:FindFirstChild("StarBtn")
					if sb then
						sb.Text      = favorites[data.Name] and "★" or "☆"
						sb.TextColor3 = favorites[data.Name] and THEME.STAR or THEME.TEXT_MUTED
					end
				end
			end

			-- Remove from favorites page
			local favPage = pages["Favorites ⭐"]
			local existing = favPage and favPage:FindFirstChild(data.Name)
			if existing then existing:Destroy() end

			-- Rebuild count badge for favorites
			local favCount = 0
			if favPage then
				for _, c in pairs(favPage:GetChildren()) do
					if c:IsA("TextButton") then favCount += 1 end
				end
			end

			-- Add to favorites page if now favorited
			if favorites[data.Name] then
				buildSlot(pages["Favorites ⭐"], true)
				favCount += 1
				notify("Favorited", data.Name .. " added to Favorites ⭐", "success", 2)
			else
				notify("Removed", data.Name .. " removed from Favorites", "info", 2)
			end

			tabCounts["Favorites ⭐"] = favCount
			updateTabCounter("Favorites ⭐")
		end)

		return slot
	end -- end buildSlot

	-- Auto-populate favorites page on load
	if favorites[data.Name] then
		buildSlot(pages["Favorites ⭐"], true)

		local favCount = 0
		for _, c in pairs(pages["Favorites ⭐"]:GetChildren()) do
			if c:IsA("TextButton") then favCount += 1 end
		end
		tabCounts["Favorites ⭐"] = favCount
		updateTabCounter("Favorites ⭐")
	end

	buildSlot(pages[data.Tab], false)
end

