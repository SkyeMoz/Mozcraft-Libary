local tooltipActive = false
local function showTooltip(text, obj)
	tooltipLabel.Text = text
	local textSize = game:GetService("TextService"):GetTextSize(
		text, 12, Enum.Font.Gotham, Vector2.new(400, 28)
	)
	tooltipFrame.Size     = UDim2.new(0, textSize.X + 16, 0, 28)
	tooltipFrame.Visible  = true
	tooltipActive         = true

	-- follow mouse
	task.spawn(function()
		while tooltipActive and tooltipFrame.Visible do
			local mp = UserInputService:GetMouseLocation()
			tooltipFrame.Position = UDim2.new(0, mp.X + 12, 0, mp.Y - 34)
			RunService.Heartbeat:Wait()
		end
	end)
end

local function hideTooltip()
	tooltipActive        = false
	tooltipFrame.Visible = false
end

local function addTooltip(obj, text)
	obj.MouseEnter:Connect(function() showTooltip(text, obj) end)
	obj.MouseLeave:Connect(function() hideTooltip() end)
end

-- ╔══════════════════════════╗
-- ║   RIPPLE CLICK EFFECT    ║
-- ╚══════════════════════════╝
local function addRipple(button, color)
	color = color or Color3.fromRGB(255, 255, 255)
	button.ClipsDescendants = true

	button.MouseButton1Down:Connect(function()
		local mp   = UserInputService:GetMouseLocation()
		local abs  = button.AbsolutePosition
		local rx   = mp.X - abs.X
		local ry   = mp.Y - abs.Y

		local rip = Instance.new("Frame")
		rip.Size                = UDim2.new(0, 0, 0, 0)
		rip.Position            = UDim2.new(0, rx, 0, ry)
		rip.AnchorPoint         = Vector2.new(0.5, 0.5)
		rip.BackgroundColor3    = color
		rip.BackgroundTransparency = 0.7
		rip.ZIndex              = button.ZIndex + 1
		rip.Parent              = button
		corner(rip, 999)

		local maxSize = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 2.5
		tween(rip, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, maxSize, 0, maxSize),
			BackgroundTransparency = 1,
		})
		game:GetService("Debris"):AddItem(rip, 0.5)
	end)
end

