-- ║       CREATE TAB         ║
-- ╚══════════════════════════╝
function MozCraft:createTab(name)
	if pages[name] then return end
	tabCounts[name] = 0

	local btn = makeButton{
		Name                   = "Tab_" .. name,
		Text                   = name .. " ",
		Size                   = UDim2.new(0, 0, 1, -4),
		BackgroundColor3       = Color3.fromRGB(0, 0, 0),
		BackgroundTransparency = 1,
		TextColor3             = THEME.TEXT_SECONDARY,
		Font                   = Enum.Font.GothamSemibold,
		TextSize               = 10,
		AutomaticSize          = Enum.AutomaticSize.X,
		ZIndex                 = 9,
		Parent                 = tabScroll,
	}
	corner(btn, 5)
	padding(btn, 0, 8, 0, 8)

	-- Count badge (small, right side of tab)
	makeLabel{
		Name       = "CountBadge",
		Size       = UDim2.new(0, 14, 0, 12),
		Position   = UDim2.new(1, -16, 0.5, -6),
		Text       = "0",
		TextColor3 = THEME.TEXT_MUTED,
		Font       = Enum.Font.GothamBold,
		TextSize   = 8,
		ZIndex     = 10,
		Parent     = btn,
	}

	-- Content page — 4-column grid
	local page = Instance.new("ScrollingFrame")
	page.Name                   = "Page_" .. name
	page.Size                   = UDim2.new(1, 0, 1, 0)
	page.CanvasSize             = UDim2.new(0, 0, 0, 0)
	page.AutomaticCanvasSize    = Enum.AutomaticSize.Y
	page.ScrollBarThickness     = 2
	page.ScrollBarImageColor3   = THEME.ACCENT
	page.BackgroundTransparency = 1
	page.Visible                = false
	page.ZIndex                 = 8
	page.Parent                 = contentHolder

	-- FIX: 4-column grid, 78×78 cards
	local grid = Instance.new("UIGridLayout")
	grid.CellSize    = UDim2.new(0, 78, 0, 78)
	grid.CellPadding = UDim2.new(0, 6, 0, 6)
	grid.SortOrder   = Enum.SortOrder.Name
	grid.Parent      = page
	padding(page, 4, 4, 4, 4)

	grid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		refreshPageCanvas(page)
	end)

	btn.MouseButton1Click:Connect(function()
		playSound(SND.click)
		MozCraft:selectTab(name)
	end)
	btn.MouseEnter:Connect(function()
		if btn.TextColor3 == THEME.TEXT_PRIMARY then return end
		safeTween(btn, TI.hover, {TextColor3 = Color3.fromRGB(195, 195, 205)})
	end)
	btn.MouseLeave:Connect(function()
		if btn.TextColor3 == THEME.TEXT_PRIMARY then return end
		safeTween(btn, TI.hover, {TextColor3 = THEME.TEXT_SECONDARY})
	end)

	pages[name]      = page
	tabButtons[name] = btn
	task.defer(refreshTabCanvas)
end

-- ╔══════════════════════════╗
-- ║       SELECT TAB         ║
-- ╚══════════════════════════╝
function MozCraft:selectTab(name)
	if not pages[name] then return end
	emptyState.Visible = false
	for _, p in pairs(pages)      do p.Visible = false end
	for _, b in pairs(tabButtons) do
		safeTween(b, TI.tab, {TextColor3 = THEME.TEXT_SECONDARY})
	end
	pages[name].Visible = true
	safeTween(tabButtons[name], TI.tab, {TextColor3 = THEME.TEXT_PRIMARY})
	currentTab = name
	repositionHighlight(name)
end

