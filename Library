		-- shimmer
		local shimmer = makeFrame{
			Size             = UDim2.new(0.3, 0, 1, 0),
			Position         = UDim2.new(-0.3, 0, 0, 0),
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			BackgroundTransparency = 0.9,
			ZIndex           = 9,
			Parent           = sk,
		}
		tween(shimmer, TweenInfo.new(1, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1), {
			Position = UDim2.new(1.3, 0, 0, 0)
		})
		table.insert(skels, sk)
	end

	task.delay(0.8, function()
		for _, sk in ipairs(skels) do
			tween(sk, TWEEN_MED, {BackgroundTransparency = 1})
			task.wait(0.05)
		end
		task.wait(0.4)
		for _, sk in ipairs(skels) do sk:Destroy() end
	end)
end

