function MozCraft:createTab(name)
	if tabs[name] then
		return
	end

	local btn = Instance.new("TextButton")
	btn.Name = name .. "_Tab"
	btn.Text = name
	btn.Size = UDim2.new(0, 110, 1, 0)
	btn.BackgroundColor3 = Color3.fromRGB(18, 18, 26)
	btn.BackgroundTransparency = 0.1
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.Font = Enum.Font.GothamSemibold
	btn.TextSize = 13
	btn.AutoButtonColor = false
	btn.Parent = tabScroll
	round(btn, UDim.new(0, 10))
	local btnStroke = stroke(btn, Color3.fromRGB(255, 255, 255), 1, 0.9)
	local btnScale = makeScale(btn, 1)

	local g = gradient(
		btn,
		Color3.fromRGB(26, 26, 34),
		Color3.fromRGB(85, 85, 95),
		90
	)

	local page = Instance.new("ScrollingFrame")
	page.Name = name .. "_Page"
	page.Size = UDim2.new(1, 0, 1, 0)
	page.CanvasSize = UDim2.new(0, 0, 0, 0)
	page.ScrollBarThickness = 6
	page.ScrollBarImageColor3 = Color3.fromRGB(190, 190, 190)
	page.BackgroundTransparency = 1
	page.Visible = false
	page.Parent = holder

	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.new(0, 92, 0, 92)
	grid.CellPadding = UDim2.new(0, 8, 0, 8)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = page

	grid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		updatePageCanvas(page, grid)
		updateEmptyState()
	end)

	page.ChildAdded:Connect(function()
		updatePageCanvas(page, grid)
		updateEmptyState()
	end)

	page.ChildRemoved:Connect(function()
		updatePageCanvas(page, grid)
		updateEmptyState()
	end)

	btn.MouseEnter:Connect(function()
		tween(btnScale, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1.03 })
		tween(btnStroke, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = 0.55 })
	end)

	btn.MouseLeave:Connect(function()
		tween(btnScale, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 })
		tween(btnStroke, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = 0.9 })
	end)

	btn.MouseButton1Click:Connect(function()
		safePlay(clickSound)
		selectTab(name)
	end)

	tabs[name] = {
		button = btn,
		page = page,
		grid = grid,
	}

	updateTabCanvas()

	if not currentTabName then
		task.defer(function()
			selectTab(name)
		end)
	end
end

