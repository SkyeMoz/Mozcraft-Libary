-- ═══════════════════════════════════════════════
--  DRAG SYSTEM
-- ═══════════════════════════════════════════════
do
    local dragging, dragStart, startX, startY = false, nil, 0, 0

    local function startDrag(input)
        dragging  = true
        dragStart = input.Position
        startX    = main.Position.X.Offset
        startY    = main.Position.Y.Offset
    end

    local function updateDrag(input)
        if not dragging then return end
        local dx = input.Position.X - dragStart.X
        local dy = input.Position.Y - dragStart.Y
        local nx = startX + dx
        local ny = startY + dy
        main.Position        = UDim2.new(main.Position.X.Scale, nx, main.Position.Y.Scale, ny)
        outerFrame.Position  = UDim2.new(0.5, nx-(invW+8)/2, 0.5, ny-(invH+8)/2)
        midFrame.Position    = UDim2.new(0.5, nx-(invW+4)/2, 0.5, ny-(invH+4)/2)
    end

    headerBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            startDrag(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            updateDrag(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

-- ═══════════════════════════════════════════════
--  OPEN / CLOSE ANIMATIONS
-- ═══════════════════════════════════════════════
local function resetPosition()
    main.Position        = UDim2.new(0.5, -invW/2, 0.5, -invH/2)
    outerFrame.Position  = UDim2.new(0.5, -(invW+8)/2, 0.5, -(invH+8)/2)
    midFrame.Position    = UDim2.new(0.5, -(invW+4)/2, 0.5, -(invH+4)/2)
end

local function openGui()
    if guiOpen then return end
    guiOpen = true
    safePlay(sndOpen)
    resetPosition()

    main.Visible        = true
    outerFrame.Visible  = true
    midFrame.Visible    = true

    -- Pop-in animation
    main.Size = UDim2.new(0, invW*0.85, 0, invH*0.85)
    main.Position = UDim2.new(0.5, -invW*0.85/2, 0.5, -invH*0.85/2)
    main.BackgroundTransparency = 0.3

    TweenService:Create(main, TWEEN_SPRING, {
        Size = UDim2.new(0, invW, 0, invH),
        Position = UDim2.new(0.5, -invW/2, 0.5, -invH/2),
        BackgroundTransparency = 0
    }):Play()

    if not currentTab and #tabOrder > 0 then
        selectTab(tabOrder[1])
    else
        applyFilter()
    end
end

local function closeGui()
    if not guiOpen then return end
    guiOpen = false
    safePlay(sndClose)
    tooltip.Visible = false

    local tw = TweenService:Create(main, TWEEN_MED, {
        Size = UDim2.new(0, invW*0.88, 0, invH*0.88),
        Position = UDim2.new(0.5, -invW*0.88/2, 0.5, -invH*0.88/2),
        BackgroundTransparency = 0.4
    })
    tw:Play()
    tw.Completed:Connect(function()
        main.Visible        = false
        outerFrame.Visible  = false
        midFrame.Visible    = false
        main.Size           = UDim2.new(0, invW, 0, invH)
        main.BackgroundTransparency = 0
    end)
end

toggleBtn.MouseButton1Click:Connect(function()
    safePlay(sndClick)
    if guiOpen then closeGui() else openGui() end
end)

closeBtn.MouseButton1Click:Connect(function()
    safePlay(sndClick)
    closeGui()
end)

-- ═══════════════════════════════════════════════
--  KEYBINDS
-- ═══════════════════════════════════════════════
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    local key = input.KeyCode
    if key == Enum.KeyCode.E or key == Enum.KeyCode.I then
        if guiOpen then closeGui() else openGui() end
    end
end)

-- ═══════════════════════════════════════════════
--  HOLD TOGGLE 10s TO DESTROY
-- ═══════════════════════════════════════════════
local holding = false
toggleBtn.MouseButton1Down:Connect(function()
    holding = true
    task.spawn(function()
        local t0 = tick()
        while holding do
            if tick()-t0 >= 10 then guiRoot:Destroy() return end
            task.wait(0.1)
        end
    end)
end)
toggleBtn.MouseButton1Up:Connect(function() holding = false end)

-- ═══════════════════════════════════════════════
--  INITIALIZE BUILT-IN TABS
-- ═══════════════════════════════════════════════
-- Favorites is always added last, but registered early
task.defer(function()
    if not tabs["Favorites"] then
        MozCraft:createTab({ Name = "Favorites" })
    end
    if #tabOrder > 0 and not currentTab then
        selectTab(tabOrder[1])
    end
end)

-- ═══════════════════════════════════════════════
--  RETURN LIBRARY
-- ═══════════════════════════════════════════════
return MozCraft

