	corner(btn, 8)
	btn.MouseEnter:Connect(function()
		tween(btn, TWEEN_FAST, {BackgroundTransparency = 0.3})
	end)
	btn.MouseLeave:Connect(function()
		tween(btn, TWEEN_FAST, {BackgroundTransparency = 0})
	end)
	addRipple(btn)
	return btn
end

