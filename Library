local windowOpen = false

local function openWindow()
	windowOpen                        = true
	mainWindow.Visible                = true
	mainWindow.BackgroundTransparency = 1
	mainWindow.Size                   = UDim2.new(0, WIN_W - 30, 0, WIN_H - 20)
	safeTween(blurOverlay, TI.med,  {BackgroundTransparency = 0.65})
	safeTween(mainWindow,  TI.open, {Size = fullSize, BackgroundTransparency = 0})
	playSound(SND.open)
end

local function closeWindow()
	windowOpen = false
	safeTween(blurOverlay, TI.med, {BackgroundTransparency = 1})
	local t = safeTween(mainWindow, TI.med, {
		Size = UDim2.new(0, WIN_W - 30, 0, WIN_H - 20), BackgroundTransparency = 1,
	})
	local function finish()
		if not windowOpen then mainWindow.Visible = false end
	end
	if t then t.Completed:Connect(finish) else finish() end
	playSound(SND.close)
end

