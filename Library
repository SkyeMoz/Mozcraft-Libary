local function makeWindowBtn(icon, xOffset, col)
	local btn = makeButton{
		Size             = UDim2.new(0, 28, 0, 28),
		Position         = UDim2.new(1, xOffset, 0.5, -14),
		BackgroundColor3 = col,
		Text             = icon,
