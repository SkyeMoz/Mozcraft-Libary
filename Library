local function buildItemSlot(data)
    local slot = makeButton(gridScroll,
        UDim2.new(0, R.SLOT_SZ, 0, R.SLOT_SZ),
        UDim2.new(0,0,0,0),
        C.SLOT, 6)
    slot.Name = data.Name
    slot:SetAttribute("Tab", data.Tab)
    slot.LayoutOrder = #allItems

    -- Inset bevel
    addInsetBevel(slot, 7)

    -- Item icon
    if data.Icon and data.Icon ~= 0 then
        makeImage(slot, data.Icon,
            UDim2.new(0, R.SLOT_SZ-6, 0, R.SLOT_SZ-6),
            UDim2.new(0, 3, 0, 3), 7)
    else
        -- text fallback
        makeLabel(slot, string.sub(data.Name,1,2),
            UDim2.new(1,0,1,0), UDim2.new(0,0,0,0),
            FONT, R.FONT_SIZE-1, C.TEXT_WHITE, Enum.TextXAlignment.Center, 7)
    end

    -- Toggle indicator (shown when Logic == "Toggle" and enabled)
    local toggleIndicator = makeFrame(slot,
        UDim2.new(0,6,0,6),
        UDim2.new(0,1,1,-7),
        C.TOGGLE_ON, 8)
    toggleIndicator.Name    = "ToggleInd"
    toggleIndicator.Visible = (data.Logic == "Toggle") and (toggleStates[data.Name] == true)
    addCornerRadius(toggleIndicator, 3)

    -- Favorite star
    local starBtn = makeButton(slot,
        UDim2.new(0, 12, 0, 12),
        UDim2.new(1,-13,0,1),
        Color3.new(0,0,0), 8)
    starBtn.BackgroundTransparency = 1
    starBtn.Name = "FavStar"
    local starLbl = makeLabel(starBtn, favorites[data.Name] and "★" or "",
        UDim2.new(1,0,1,0), UDim2.new(0,0,0,0),
        FONT, 11, C.FAV_ON, Enum.TextXAlignment.Center, 9)
    starLbl.Name = "StarText"

    -- Hover / press animations
    slot.MouseEnter:Connect(function()
        TweenService:Create(slot, TWEEN_FAST, {BackgroundColor3 = C.SLOT_HOV}):Play()
        if not isMobile then
            local mp = UserInputService:GetMouseLocation()
            local w  = math.max(#data.Name*8+12, 80)
            tooltip.Size     = UDim2.new(0, w, 0, 36)
            tooltip.Position = UDim2.new(0, mp.X+14, 0, mp.Y-42)
            ttTitle.Text     = data.Name
            ttSub.Text       = (data.Tab or "")..(data.Logic == "Toggle" and " • Toggle" or "")
            tooltip.Visible  = true
        end
    end)
    slot.MouseLeave:Connect(function()
        TweenService:Create(slot, TWEEN_FAST, {BackgroundColor3 = C.SLOT}):Play()
        tooltip.Visible = false
    end)
    slot.MouseButton1Down:Connect(function()
        TweenService:Create(slot, TWEEN_FAST, {BackgroundColor3 = C.SLOT_SEL}):Play()
    end)
    slot.MouseButton1Up:Connect(function()
        TweenService:Create(slot, TWEEN_FAST, {BackgroundColor3 = C.SLOT_HOV}):Play()
    end)

    -- Click logic
    slot.MouseButton1Click:Connect(function()
        safePlay(sndClick)
        tooltip.Visible = false

        if data.Logic == "Execute" then
            pcall(function()
                if loadstring and game.HttpGet then
                    loadstring(game:HttpGet(data.Script))()
                end
            end)
        elseif data.Logic == "Copy" then
            pcall(function() setclipboard(tostring(data.Script)) end)
        elseif data.Logic == "Function" and type(data.Callback) == "function" then
            pcall(data.Callback)
        elseif data.Logic == "Toggle" then
            toggleStates[data.Name] = not toggleStates[data.Name]
            local isOn = toggleStates[data.Name]
            toggleIndicator.Visible = true
            TweenService:Create(toggleIndicator, TWEEN_FAST, {
                BackgroundColor3 = isOn and C.TOGGLE_ON or C.TOGGLE_OFF
            }):Play()
            if isOn and data.EnabledScript then
                pcall(function()
                    if loadstring and game.HttpGet then
                        loadstring(game:HttpGet(data.EnabledScript))()
                    end
                end)
            elseif not isOn and data.DisabledScript then
                pcall(function()
                    if loadstring and game.HttpGet then
                        loadstring(game:HttpGet(data.DisabledScript))()
                    end
                end)
            elseif type(data.Callback) == "function" then
                pcall(data.Callback, isOn)
            end
        end
    end)

    -- Long press = favorite (mobile) | Right click = favorite (PC)
    local longPressThread = nil
    slot.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            longPressThread = task.delay(0.6, function()
                safePlay(sndFav)
                favorites[data.Name] = not favorites[data.Name]
                saveFavorites()
                starLbl.Text = favorites[data.Name] and "★" or ""
                applyFilter()
                -- ripple feedback
                TweenService:Create(slot, TWEEN_FAST, {BackgroundColor3 = C.FAV_ON}):Play()
                task.wait(0.15)
                TweenService:Create(slot, TWEEN_FAST, {BackgroundColor3 = C.SLOT}):Play()
            end)
        end
    end)
    slot.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            if longPressThread then
                task.cancel(longPressThread)
                longPressThread = nil
            end
        end
    end)
    slot.MouseButton2Click:Connect(function()
        safePlay(sndFav)
        favorites[data.Name] = not favorites[data.Name]
        saveFavorites()
        starLbl.Text = favorites[data.Name] and "★" or ""
        applyFilter()
    end)

    -- Favorite star click
    starBtn.MouseButton1Click:Connect(function()
        safePlay(sndFav)
        favorites[data.Name] = not favorites[data.Name]
        saveFavorites()
        starLbl.Text = favorites[data.Name] and "★" or ""
        applyFilter()
    end)

    return slot
end

