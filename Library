	slot.Parent = parent
	corner(slot, 9)
	stroke(slot, Color3.fromRGB(255,255,255), 1, 0.93)

	-- Icon background circle
	local iconBG = Instance.new("Frame")
	iconBG.Size = UDim2.new(0,42,0,42)
	iconBG.Position = UDim2.new(0.5,-21,0,8)
	iconBG.BackgroundColor3 = Color3.fromRGB(32,32,38)
	iconBG.ZIndex = 7
	iconBG.Parent = slot
	corner(iconBG, 21)

	local icon = Instance.new("ImageLabel")
	icon.Size = UDim2.new(0,30,0,30)
	icon.Position = UDim2.new(0.5,-15,0.5,-15)
	icon.BackgroundTransparency = 1
	icon.Image = "rbxassetid://" .. (data.Icon or "4483345998")
	icon.ZIndex = 8
	icon.Parent = iconBG

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1,-4,0,18)
	nameLabel.Position = UDim2.new(0,2,0,54)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = data.Name
	nameLabel.TextColor3 = Color3.fromRGB(210,210,220)
	nameLabel.Font = Enum.Font.Gotham
	nameLabel.TextSize = 11
	nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	nameLabel.ZIndex = 7
	nameLabel.Parent = slot

	-- Status dot
	if data.Status and StatusColors[data.Status] then
		local dot = Instance.new("Frame")
		dot.Size = UDim2.new(0,6,0,6)
		dot.Position = UDim2.new(0,5,0,6)
		dot.BackgroundColor3 = StatusColors[data.Status]
		dot.ZIndex = 9
		dot.Parent = slot
		corner(dot, 3)
	end

	-- Favorite star
	local isFav = favorites[data.Name]
	local star = Instance.new("TextButton")
	star.Size = UDim2.new(0,16,0,16)
	star.Position = UDim2.new(1,-18,0,4)
	star.BackgroundTransparency = 1
	star.Text = isFav and "★" or "☆"
	star.TextColor3 = isFav and Color3.fromRGB(255,200,0) or Color3.fromRGB(80,80,90)
	star.Font = Enum.Font.GothamBold
	star.TextSize = 13
	star.ZIndex = 10
	star.Parent = slot

	-- Hover animation
	slot.MouseEnter:Connect(function()
		tween(slot, 0.12, {BackgroundColor3 = Color3.fromRGB(34,34,40)}):Play()
		tween(iconBG, 0.12, {BackgroundColor3 = Color3.fromRGB(40,40,50)}):Play()
	end)
	slot.MouseLeave:Connect(function()
		tween(slot, 0.12, {BackgroundColor3 = Color3.fromRGB(26,26,30)}):Play()
		tween(iconBG, 0.12, {BackgroundColor3 = Color3.fromRGB(32,32,38)}):Play()
	end)

	-- Press animation
	slot.MouseButton1Down:Connect(function()
		tween(slot, 0.08, {BackgroundColor3 = Color3.fromRGB(22,22,28)}):Play()
	end)
	slot.MouseButton1Up:Connect(function()
		tween(slot, 0.12, {BackgroundColor3 = Color3.fromRGB(34,34,40)}):Play()
	end)

	-- Execute / Copy logic
	slot.MouseButton1Click:Connect(function()
		playClick()
		if data.Logic == "Execute" then
			pcall(function()
				loadstring(game:HttpGet(data.Script))()
			end)
		elseif data.Logic == "Copy" then
			pcall(function()
				setclipboard(data.Script)
			end)
		end
	end)

	-- Star logic
	star.MouseButton1Click:Connect(function()
		playClick()
		favorites[data.Name] = not favorites[data.Name]
		saveFavorites()

		-- Sync all star buttons across pages
		for _, page in pairs(pages) do
			for _, child in ipairs(page:GetChildren()) do
				if child:IsA("TextButton") and child.Name == data.Name then
					local s = child:FindFirstChildWhichIsA("TextButton")
					if s then
						s.Text      = favorites[data.Name] and "★" or "☆"
						s.TextColor3 = favorites[data.Name]
							and Color3.fromRGB(255,200,0)
							or Color3.fromRGB(80,80,90)
					end
				end
			end
		end

		-- Remove from favorites page
		local favPage = pages["Favorites ⭐"]
		for _, child in ipairs(favPage:GetChildren()) do
			if child:IsA("TextButton") and child.Name == data.Name then
				child:Destroy()
			end
		end

		-- Add to favorites page if now favorited
		if favorites[data.Name] then
			buildSlot(data, favPage)
		end
	end)

	return slot
end

------------------------------------------------------------
-- CREATE SLOT (public API)
------------------------------------------------------------
function MozCraft:createSlot(data)
	if not pages[data.Tab] then
		self:createTab(data.Tab)
	end

	-- Build in its tab
	buildSlot(data, pages[data.Tab])

	-- Build in favorites if saved
	if favorites[data.Name] then
		buildSlot(data, pages["Favorites ⭐"])
	end

	table.insert(allSlots, data)
	slotCount = slotCount + 1
	scriptCountLabel.Text = slotCount .. " Script" .. (slotCount == 1 and "" or "s") .. " Loaded"
end

------------------------------------------------------------
-- SEARCH FILTERING
------------------------------------------------------------
searchBox:GetPropertyChangedSignal("Text"):Connect(function()
	playTyping()
	local query = string.lower(searchBox.Text)

	for _, page in pairs(pages) do
		for _, child in ipairs(page:GetChildren()) do
			if child:IsA("TextButton") then
				if query == "" then
					child.Visible = true
				else
					child.Visible = string.find(string.lower(child.Name), query, 1, true) ~= nil
				end
			end
		end
	end
end)

