local function refreshTabCanvas()
	tabScroll.CanvasSize = UDim2.new(0, tabLayout.AbsoluteContentSize.X + 6, 0, 0)
end

local function refreshPageCanvas(page)
	if not page then return end
	page.CanvasSize = UDim2.new(0, 0, 0, 0)
end

local currentTab = nil

local function repositionHighlight(name)
	local targetBtn = name and tabButtons[name]
	if not targetBtn then return end
	task.defer(function()
		if not targetBtn or not targetBtn.Parent then return end
		local relX = targetBtn.AbsolutePosition.X - tabBarContainer.AbsolutePosition.X
		safeTween(tabHighlight, TI.tab, {
			Position = UDim2.new(0, relX, 0, 2),
			Size     = UDim2.new(0, targetBtn.AbsoluteSize.X, 1, -4),
		})
	end)
end

-- Hoisted fav slot counter
local function countFavSlots()
	local favPage = pages["Favorites ⭐"]
	if not favPage then return 0 end
	local n = 0
	for _, c in ipairs(favPage:GetChildren()) do
		if c:IsA("TextButton") then n += 1 end
	end
	return n
end

