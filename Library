        end)
        optBtn.MouseLeave:Connect(function()
            TweenService:Create(optBtn, TWEEN_FAST, {BackgroundColor3 = C.SLOT}):Play()
        end)
        optBtn.MouseButton1Click:Connect(function()
            selected    = tostring(opt)
            ddLabel.Text = selected
            open        = false
            popup.Visible = false
            if type(data.Callback) == "function" then pcall(data.Callback, selected) end
        end)
    end

    ddBtn.MouseButton1Click:Connect(function()
        open = not open
        popup.Visible = open
        if open then
            local abs = ddBtn.AbsolutePosition
            popup.Position = UDim2.new(0, abs.X, 0, abs.Y + ddBtn.AbsoluteSize.Y + 2)
        end
    end)
end

function MozCraft:createKeybind(data)
    local tabName = data.Tab or "Settings"
    if not tabs[tabName] then
        self:createTab({ Name = tabName, Settings = true })
    end

    local bound = data.Default
    local listening = false

    local frame = makeSettingsContainer(tabName)
    makeLabel(frame, data.Name or "Keybind",
        UDim2.new(0.6,0,1,0), UDim2.new(0,8,0,0),
        FONT, R.FONT_SIZE, C.TEXT_WHITE, Enum.TextXAlignment.Left, 7)

    local kBtn = makeButton(frame,
        UDim2.new(0,70,0,24),
        UDim2.new(1,-76,0.5,-12),
        C.INPUT_BG, 7)
    local kLbl = makeLabel(kBtn,
        bound and tostring(bound) or "None",
        UDim2.new(1,0,1,0), UDim2.new(0,0,0,0),
        FONT, R.FONT_SIZE-1, C.TEXT_WHITE, Enum.TextXAlignment.Center, 8)
    addInsetBevel(kBtn, 8)

    kBtn.MouseButton1Click:Connect(function()
        listening = true
        kLbl.Text       = "..."
        kBtn.BackgroundColor3 = C.INPUT_FOCUS
    end)

    UserInputService.InputBegan:Connect(function(input, gpe)
        if listening and not gpe then
            listening  = false
            bound      = input.KeyCode
            kLbl.Text  = tostring(input.KeyCode):gsub("Enum.KeyCode.","")
            kBtn.BackgroundColor3 = C.INPUT_BG
            if type(data.Callback) == "function" then pcall(data.Callback, bound) end
        end
    end)
end

function MozCraft:createColorPicker(data)
    local tabName = data.Tab or "Settings"
    if not tabs[tabName] then
        self:createTab({ Name = tabName, Settings = true })
    end

    local col = data.Default or Color3.fromRGB(255,255,255)

    local frame = makeSettingsContainer(tabName)
    makeLabel(frame, data.Name or "Color",
        UDim2.new(0.65,0,1,0), UDim2.new(0,8,0,0),
        FONT, R.FONT_SIZE, C.TEXT_WHITE, Enum.TextXAlignment.Left, 7)

    local preview = makeFrame(frame,
        UDim2.new(0,26,0,26),
        UDim2.new(1,-32,0.5,-13),
        col, 7)
    addInsetBevel(preview, 8)

    -- Simple R/G/B sliders as note: full color picker is complex,
    -- this creates a clickable swatch that cycles preset colors
    local presets = {
        Color3.fromRGB(255,85,85),
        Color3.fromRGB(255,185,0),
        Color3.fromRGB(85,255,85),
        Color3.fromRGB(85,185,255),
        Color3.fromRGB(185,85,255),
        Color3.fromRGB(255,255,255),
        Color3.fromRGB(0,0,0),
    }
    local idx = 1
    preview.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            idx = (idx % #presets) + 1
            col = presets[idx]
            preview.BackgroundColor3 = col
            if type(data.Callback) == "function" then pcall(data.Callback, col) end
        end
    end)
end

-- ═══════════════════════════════════════════════
--  PUBLIC API: createSlot
-- ═══════════════════════════════════════════════
function MozCraft:createSlot(data)
    -- Auto-create tab if needed
    if data.Tab and not tabs[data.Tab] then
        self:createTab(data.Tab)
    end

    -- Ensure Favorites tab exists
    if not tabs["Favorites"] then
        self:createTab({ Name = "Favorites", Icon = nil })
    end

    local slot = buildItemSlot(data)
    table.insert(allItems, data)
    applyFilter()
    return slot
end

