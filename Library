-- ║       CREATE SLOT        ║
-- ║  78×78 fixed cards       ║
-- ║  Hover: border+brightness║
-- ║  NO scale, NO bounce     ║
-- ╚══════════════════════════╝
function MozCraft:createSlot(data)
	if type(data) ~= "table" or not data.Name or not data.Tab then
		warn("[MozCraft] createSlot: invalid data table (Name and Tab required)")
		return
	end
	data.Logic  = data.Logic  or "Execute"
	data.Icon   = tostring(data.Icon or "3959438440")
	data.Script = data.Script or ""

	if not pages[data.Tab] then self:createTab(data.Tab) end

	-- Only count non-favorites tabs toward totalSlots
	if data.Tab ~= "Favorites ⭐" then
		tabCounts[data.Tab] = (tabCounts[data.Tab] or 0) + 1
		updateTabCounter(data.Tab)
		totalSlots += 1
		updateScriptCounter()
	end

	local function buildSlot(parentPage)
		-- Prevent duplicate: destroy existing slot with same name in this page
		local existing = parentPage:FindFirstChild(data.Name)
		if existing then existing:Destroy() end

		local slot = makeButton{
			Name                   = data.Name,
			Size                   = UDim2.new(0, 78, 0, 78),
			BackgroundColor3       = THEME.BG_CARD,
			BackgroundTransparency = 0,
			Text                   = "",
			ZIndex                 = 9,
			Parent                 = parentPage,
		}
		corner(slot, 9)
		local slotStroke = stroke(slot, THEME.BORDER, 1, 0.5)
		addRipple(slot, THEME.ACCENT)
		gradient(slot, ColorSequence.new{
			ColorSequenceKeypoint.new(0, Color3.fromRGB(26, 26, 34)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(18, 18, 24)),
		}, 135)

		-- Icon
		local icon = Instance.new("ImageLabel")
		icon.Size                   = UDim2.new(0, 38, 0, 38)
		icon.Position               = UDim2.new(0.5, -19, 0, 8)
		icon.BackgroundTransparency = 1
		icon.Image                  = "rbxassetid://" .. data.Icon
		icon.ZIndex                 = 10
		icon.Parent                 = slot

		local label = makeLabel{
			Size         = UDim2.new(1, -4, 0, 14),
			Position     = UDim2.new(0, 2, 1, -17),
			Text         = data.Name,
			TextColor3   = THEME.TEXT_SECONDARY,
			Font         = Enum.Font.Gotham,
			TextSize     = 9,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex       = 10,
			Parent       = slot,
		}

		local isFav = favorites[data.Name] == true
		local star = makeButton{
			Name                   = "StarBtn",
			Size                   = UDim2.new(0, 15, 0, 15),
			Position               = UDim2.new(1, -17, 0, 2),
			BackgroundTransparency = 1,
			Text                   = isFav and "★" or "☆",
			TextColor3             = isFav and THEME.STAR or THEME.TEXT_MUTED,
			TextSize               = 11,
			Font                   = Enum.Font.GothamBold,
			ZIndex                 = 11,
			Parent                 = slot,
		}

		local statusDot = makeFrame{
			Size             = UDim2.new(0, 4, 0, 4),
			Position         = UDim2.new(0, 3, 0, 3),
			BackgroundColor3 = THEME.TEXT_MUTED,
			ZIndex           = 11,
			Parent           = slot,
		}
		corner(statusDot, 2)

		addTooltip(slot, data.Name .. (data.Logic == "Copy" and " — Copy" or " — Execute"))
		addTooltip(star, function()
			return favorites[data.Name] and "Remove Favorite" or "Add Favorite"
		end)

		-- Hover: only border color + background brightness — no size/rotation
		slot.MouseEnter:Connect(function()
			safeTween(slot,       TI.hover, {BackgroundColor3 = THEME.BG_ELEVATED})
			safeTween(label,      TI.hover, {TextColor3 = THEME.TEXT_PRIMARY})
			safeTween(slotStroke, TI.hover, {Color = THEME.ACCENT_DIM, Transparency = 0.2})
		end)
		slot.MouseLeave:Connect(function()
			safeTween(slot,       TI.hover, {BackgroundColor3 = THEME.BG_CARD})
			safeTween(label,      TI.hover, {TextColor3 = THEME.TEXT_SECONDARY})
			safeTween(slotStroke, TI.hover, {Color = THEME.BORDER, Transparency = 0.5})
		end)

		-- Per-slot connection tracking for clean teardown
		local slotConns = {}
		local function slotConn(signal, fn)
			local c = signal:Connect(fn)
			slotConns[#slotConns + 1] = c
			return c
		end

		slot.AncestryChanged:Connect(function()
			if not slot.Parent then
				for _, c in ipairs(slotConns) do
					pcall(function() c:Disconnect() end)
				end
				table.clear(slotConns)
				removeTooltip(slot)
				removeTooltip(star)
			end
		end)

		-- ── EXECUTION — guarded against double-fire ──
		local executing = false

		slotConn(slot.MouseButton1Click, function()
			if executing then return end
			executing = true
			playSound(SND.click)
			recordHistory(data.Name, data.Logic)

			-- Brief press feedback (background only, no scale)
			safeTween(slot, TI.button, {BackgroundColor3 = THEME.BG_SURFACE})
			task.delay(0.12, function()
				if slot and slot.Parent then
					safeTween(slot, TI.button, {BackgroundColor3 = THEME.BG_CARD})
				end
			end)
			safeTween(statusDot, TI.button, {BackgroundColor3 = THEME.ACCENT})

			task.spawn(function()
				local ok, err
				if data.Logic == "Execute" then
					ok, err = pcall(function()
						if not data.Script or data.Script == "" then
							error("No script URL or content provided")
						end
						-- HTTP fetch
						local httpOk, src = pcall(function()
							return game:HttpGet(data.Script)
						end)
						if not httpOk then
							error("HTTP request failed: " .. tostring(src))
						end
						if not src or src == "" then
							error("Server returned an empty response")
						end
						-- Compile
						if type(loadstring) ~= "function" then
							error("loadstring is unavailable in this executor")
						end
						local fn, compileErr = loadstring(src)
						if not fn then
							error("Compile error: " .. tostring(compileErr))
						end
						-- Execute
						fn()
					end)
				elseif data.Logic == "Copy" then
					ok, err = pcall(function()
						if type(setclipboard) ~= "function" then
							error("setclipboard is not supported by this executor")
						end
						setclipboard(data.Script)
					end)
				else
					ok  = false
					err = "Unknown Logic type: " .. tostring(data.Logic)
				end

				if not slot or not slot.Parent then
					executing = false
					return
				end

				if ok then
					safeTween(statusDot, TI.button, {BackgroundColor3 = THEME.SUCCESS})
					notify(
						data.Logic == "Copy" and "Copied!" or "Executed",
						data.Name,
						"success"
					)
				else
					safeTween(statusDot, TI.button, {BackgroundColor3 = THEME.ERROR})
					local msg = tostring(err or "Unknown error")
					-- User-friendly error messages
					if msg:find("setclipboard", 1, true) then
						notify("Clipboard Unavailable", "Your executor does not support clipboard operations.", "warning")
					elseif msg:find("HTTP request failed", 1, true) then
						notify("Network Error", "Could not reach the script server. Check your connection.", "error")
					elseif msg:find("empty response", 1, true) then
						notify("Server Error", "The script server returned an empty response.", "error")
					elseif msg:find("Compile error", 1, true) then
						notify("Script Error", "Script failed to compile. " .. msg:sub(1, 60), "error")
					elseif msg:find("loadstring", 1, true) then
						notify("Executor Error", "loadstring is not available in this executor.", "error")
					else
						notify("Error", msg:sub(1, 72), "error")
					end
				end

				-- Restore status dot after delay
				task.wait(2.5)
				if slot and slot.Parent then
					safeTween(statusDot, TI.slow, {BackgroundColor3 = THEME.TEXT_MUTED})
				end
				executing = false
			end)
		end)

		-- ── FAVORITES — guarded, no desync ──
		local starBusy = false

		slotConn(star.MouseButton1Click, function()
			if starBusy then return end
			starBusy = true
			playSound(SND.star)

			local wasFav = favorites[data.Name] == true
			favorites[data.Name] = not wasFav
			saveFavorites()
			local nowFav = favorites[data.Name] == true

			-- Sync star buttons across ALL pages (no desync)
			for _, pg in pairs(pages) do
				local s = pg:FindFirstChild(data.Name)
				if s then
					local sb = s:FindFirstChild("StarBtn")
					if sb then
						sb.Text       = nowFav and "★" or "☆"
						sb.TextColor3 = nowFav and THEME.STAR or THEME.TEXT_MUTED
					end
				end
			end

			-- Update Favorites page
			local favPage = pages["Favorites ⭐"]
			if favPage then
				-- Always remove existing entry first to prevent duplicates
				local existingFav = favPage:FindFirstChild(data.Name)
				if existingFav then existingFav:Destroy() end

				if nowFav then
					buildSlot(favPage)
					notify("Favorited", data.Name .. " added to Favorites ⭐", "success", 2)
				else
					notify("Removed", data.Name .. " removed from Favorites", "info", 2)
				end

				-- Recount from actual DOM to stay accurate
				task.defer(function()
					tabCounts["Favorites ⭐"] = countFavSlots()
					updateTabCounter("Favorites ⭐")
				end)
			end

			task.delay(0.3, function() starBusy = false end)
		end)

		return slot
	end -- buildSlot

	-- If already favorited, add to Favorites page immediately
	if favorites[data.Name] then
		local favPage = pages["Favorites ⭐"]
		if favPage then
			buildSlot(favPage)
			task.defer(function()
				tabCounts["Favorites ⭐"] = countFavSlots()
				updateTabCounter("Favorites ⭐")
			end)
		end
	end

	buildSlot(pages[data.Tab])
end

