	task.wait(0.1)  -- Let layout resolve AutomaticSize

	-- Apply initial scale
	applyScale()

	-- Set initial highlight to Favorites tab
	local firstBtn = tabButtons["Favorites ⭐"]
	if firstBtn then
		tabHighlight.Size     = UDim2.new(0, firstBtn.AbsoluteSize.X, 1, -4)
		tabHighlight.Position = UDim2.new(0, 2, 0, 2)
	end
	refreshTabCanvas()
	updateScriptCounter()
end)

