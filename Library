local notifCount = 0

local function notify(title, message, ntype, duration)
	notifCount += 1
	duration = duration or 3.5
	ntype    = ntype or "info"

	local accentCol = ntype == "success" and THEME.SUCCESS
		or ntype == "error" and THEME.ERROR
		or ntype == "warning" and Color3.fromRGB(255, 200, 0)
		or THEME.ACCENT

	local card = makeFrame{
		Name                 = "Notif_" .. notifCount,
		Size                 = UDim2.new(1, 0, 0, 68),
		BackgroundColor3     = THEME.BG_ELEVATED,
		BackgroundTransparency = 0.05,
		ClipsDescendants     = true,
		ZIndex               = 100,
		LayoutOrder          = notifCount,
		Parent               = notifContainer,
	}
	corner(card, 12)
	stroke(card, accentCol, 1, 0.5)

	-- accent bar
	local bar = makeFrame{
		Size             = UDim2.new(0, 3, 1, 0),
		BackgroundColor3 = accentCol,
		ZIndex           = 101,
		Parent           = card,
	}
	corner(bar, 2)

	-- icon
	local icon = makeLabel{
		Size             = UDim2.new(0, 30, 0, 30),
		Position         = UDim2.new(0, 14, 0.5, -15),
		Text             = ntype == "success" and "✓" or ntype == "error" and "✕" or ntype == "warning" and "⚠" or "ℹ",
		TextColor3       = accentCol,
		TextSize         = 18,
		Font             = Enum.Font.GothamBold,
		ZIndex           = 101,
		Parent           = card,
	}

	-- title
	local tLabel = makeLabel{
		Size             = UDim2.new(1, -60, 0, 20),
		Position         = UDim2.new(0, 50, 0, 10),
		Text             = title,
		TextColor3       = THEME.TEXT_PRIMARY,
		Font             = Enum.Font.GothamBold,
		TextSize         = 13,
		TextXAlignment   = Enum.TextXAlignment.Left,
		ZIndex           = 101,
		Parent           = card,
	}

	-- message
	local mLabel = makeLabel{
		Size             = UDim2.new(1, -60, 0, 30),
		Position         = UDim2.new(0, 50, 0, 30),
		Text             = message,
		TextColor3       = THEME.TEXT_SECONDARY,
		TextSize         = 12,
		TextXAlignment   = Enum.TextXAlignment.Left,
		TextWrapped      = true,
		ZIndex           = 101,
		Parent           = card,
	}

	-- progress bar
	local progress = makeFrame{
		Size             = UDim2.new(1, 0, 0, 2),
		Position         = UDim2.new(0, 0, 1, -2),
		BackgroundColor3 = accentCol,
		ZIndex           = 102,
		Parent           = card,
	}

	-- slide in
	card.Position = UDim2.new(1, 10, 0, 0)
	tween(card, TWEEN_SPRING, {Position = UDim2.new(0, 0, 0, 0)})
	tween(progress, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 0, 2)})

	task.delay(duration, function()
		tween(card, TWEEN_MED, {Position = UDim2.new(1, 20, 0, 0), BackgroundTransparency = 1})
		task.wait(0.3)
		card:Destroy()
	end)
end

