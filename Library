------------------------------------------------------------
-- HOLD-TO-DELETE (10s with radial progress text)
------------------------------------------------------------
do
	local holding = false
	local holdConn

	toggleBtn.MouseButton1Down:Connect(function()
		holding = true
		progressRing.Visible = true
		radialLabel.Visible = true

		holdConn = task.spawn(function()
			local start = tick()
			while holding do
				local elapsed = tick() - start
				local pct = math.clamp(elapsed / 10, 0, 1)
				radialLabel.Text = math.floor(pct * 100) .. "%"
				if pct >= 1 then
					gui:Destroy()
					return
				end
				task.wait()
			end
			progressRing.Visible = false
			radialLabel.Visible = false
			radialLabel.Text = ""
		end)
	end)

	toggleBtn.MouseButton1Up:Connect(function()
		holding = false
	end)
end

