-- ╔══════════════════════════╗
-- ║    WINDOW DRAG LOGIC     ║
-- ╚══════════════════════════╝
local dragging   = false
local dragOffset = Vector2.new(0, 0)

titleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging   = true
		local ap   = mainWindow.AbsolutePosition
		local mp   = input.Position
		dragOffset = Vector2.new(mp.X - ap.X, mp.Y - ap.Y)
	end
end)

trackConn(UserInputService.InputChanged:Connect(function(input)
	if not dragging then return end
	if input.UserInputType ~= Enum.UserInputType.MouseMovement
		and input.UserInputType ~= Enum.UserInputType.Touch then return end
	local mp = input.Position
	local ss = ScreenGui.AbsoluteSize
	local ws = mainWindow.AbsoluteSize
	local nx = math.clamp(mp.X - dragOffset.X, 0, math.max(0, ss.X - ws.X))
	local ny = math.clamp(mp.Y - dragOffset.Y, 0, math.max(0, ss.Y - ws.Y))
	-- AnchorPoint(0.5,0.5) → position is center of window
	mainWindow.Position = UDim2.new(0, nx + ws.X * 0.5, 0, ny + ws.Y * 0.5)
end))

trackConn(UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end))

