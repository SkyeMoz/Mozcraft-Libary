------------------------------------------------------------
-- DRAG SYSTEM
------------------------------------------------------------
do
	local dragging = false
	local dragStart, startPos

	titleBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos  = main.Position
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - dragStart
			main.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)

	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

------------------------------------------------------------
-- OPEN / CLOSE ANIMATIONS
------------------------------------------------------------
local isOpen    = false
local minimized = false

local function openWindow()
	main.Visible = true
	main.Size = UDim2.new(0, WINDOW_W * 0.85, 0, WINDOW_H * 0.85)
	main.BackgroundTransparency = 1
	tween(main, 0.22, {
		Size = UDim2.new(0,WINDOW_W,0,WINDOW_H),
		BackgroundTransparency = 0
	}, Enum.EasingStyle.Sine):Play()
	isOpen = true
	minimized = false
end

local function closeWindow()
	local t = tween(main, 0.18, {
		Size = UDim2.new(0,WINDOW_W*0.9,0,WINDOW_H*0.9),
		BackgroundTransparency = 1
	}, Enum.EasingStyle.Sine)
	t:Play()
	t.Completed:Connect(function() main.Visible = false end)
	isOpen = false
end

local function toggleWindow()
	playClick()
	if isOpen then closeWindow() else openWindow() end
end

-- Minimize collapses to title bar only
local function toggleMinimize()
	playClick()
	if minimized then
		minimized = false
		tween(main, 0.2, {Size = UDim2.new(0,WINDOW_W,0,WINDOW_H)}, Enum.EasingStyle.Sine):Play()
	else
		minimized = true
		tween(main, 0.2, {Size = UDim2.new(0,WINDOW_W,0,46)}, Enum.EasingStyle.Sine):Play()
	end
end

