local function applyFilter()
    if not currentTab then return end
    local tabData = tabs[currentTab]
    if not tabData then return end

    local query = searchBox.Text or ""
    local isSettings = tabData.isSettings

    -- Show/hide appropriate container
    gridScroll.Visible  = not isSettings
    settingsList.Visible = isSettings

    if isSettings then
        -- Show/hide settings elements
        local vis = 0
        for _, el in ipairs(settingsList:GetChildren()) do
            if el:IsA("Frame") or el:IsA("TextButton") then
                local elTab = el:GetAttribute("Tab")
                if elTab == currentTab then
                    el.Visible = true
                    vis += 1
                else
                    el.Visible = false
                end
            end
        end
        emptyLabel.Visible = (vis == 0)
        countLabel.Text    = ""
        return
    end

    -- Grid items
    local isFav = (currentTab == "Favorites")
    local visible = 0
    for _, child in ipairs(gridScroll:GetChildren()) do
        if child:IsA("TextButton") then
            local name   = child.Name
            local itemTab = child:GetAttribute("Tab") or ""
            local inTab  = isFav and (favorites[name] == true)
                        or (not isFav and itemTab == currentTab)
            local matches = fuzzyMatch(name, query)
            child.Visible = inTab and matches
            if child.Visible then visible += 1 end
        end
    end
    emptyLabel.Visible = (visible == 0)
    countLabel.Text    = visible > 0 and (visible.." items") or ""
end

local function selectTab(name)
    if not tabs[name] then return end
    local prev = currentTab
    currentTab = name

    -- Update tab button visuals
    for tName, td in pairs(tabs) do
        local sel = (tName == name)
        TweenService:Create(td.btn, TWEEN_MED, {
            BackgroundColor3 = sel and C.SEL_TAB or C.PANEL
        }):Play()
        -- selected tab sticks out slightly more
        local bvTL = td.btn:FindFirstChild("BevTL")
        local bvBR = td.btn:FindFirstChild("BevBR")
        if bvTL then bvTL.BackgroundTransparency = sel and 0.7 or 0.35 end
        if bvBR then bvBR.BackgroundTransparency = sel and 0.35 or 0.7  end
    end

    applyFilter()
end

