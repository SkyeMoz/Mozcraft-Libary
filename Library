function MozCraft:Notify(options)
	local title    = options.Title    or "Notification"
	local content  = options.Content  or ""
	local duration = options.Duration or 3

	local card = Instance.new("Frame")
	card.Size = UDim2.new(1,0,0,0)
	card.AutomaticSize = Enum.AutomaticSize.Y
	card.BackgroundColor3 = Color3.fromRGB(26,26,30)
	card.BackgroundTransparency = 1
	card.ClipsDescendants = false
	card.ZIndex = 100
	card.Parent = notifHolder
	corner(card, 9)
	stroke(card, Color3.fromRGB(255,140,0), 1, 0.5)

	local accent = Instance.new("Frame")
	accent.Size = UDim2.new(0,3,1,-12)
	accent.Position = UDim2.new(0,6,0,6)
	accent.BackgroundColor3 = currentTheme[1]
	accent.ZIndex = 101
	accent.Parent = card
	corner(accent, 2)

	local tLabel = Instance.new("TextLabel")
	tLabel.Size = UDim2.new(1,-24,0,20)
	tLabel.Position = UDim2.new(0,18,0,6)
	tLabel.BackgroundTransparency = 1
	tLabel.Text = title
	tLabel.TextColor3 = Color3.fromRGB(240,240,250)
	tLabel.Font = Enum.Font.GothamBold
	tLabel.TextSize = 13
	tLabel.TextXAlignment = Enum.TextXAlignment.Left
	tLabel.ZIndex = 101
	tLabel.Parent = card

	local cLabel = Instance.new("TextLabel")
	cLabel.Size = UDim2.new(1,-24,0,0)
	cLabel.AutomaticSize = Enum.AutomaticSize.Y
	cLabel.Position = UDim2.new(0,18,0,26)
	cLabel.BackgroundTransparency = 1
	cLabel.Text = content
	cLabel.TextColor3 = Color3.fromRGB(150,150,165)
	cLabel.Font = Enum.Font.Gotham
	cLabel.TextSize = 12
	cLabel.TextXAlignment = Enum.TextXAlignment.Left
	cLabel.TextWrapped = true
	cLabel.ZIndex = 101
	cLabel.Parent = card

	local pad = Instance.new("UIPadding")
	pad.PaddingBottom = UDim.new(0,10)
	pad.Parent = card

	-- Slide in from right
	card.Position = UDim2.new(1, 20, 0, 0)
	tween(card, 0.25, {BackgroundTransparency = 0}, Enum.EasingStyle.Sine):Play()
	tween(card, 0.25, {Position = UDim2.new(0,0,0,0)}, Enum.EasingStyle.Sine):Play()

	-- Auto remove
	task.delay(duration, function()
		tween(card, 0.2, {
			BackgroundTransparency = 1,
			Position = UDim2.new(1,20,0,0)
		}, Enum.EasingStyle.Sine):Play()
		task.delay(0.25, function()
			card:Destroy()
		end)
	end)
end

