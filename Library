function MozCraft:createSlot(data)
	if not tabs[data.Tab] then
		self:createTab(data.Tab)
	end

	local function buildSlot(parent)
		local slot = Instance.new("TextButton")
		slot.Name = data.Name
		slot.Text = ""
		slot.Size = UDim2.new(0, 92, 0, 92)
		slot.BackgroundColor3 = Color3.fromRGB(18, 18, 26)
		slot.BackgroundTransparency = 0.06
		slot.AutoButtonColor = false
		slot.Parent = parent
		round(slot, UDim.new(0, 12))
		local slotStroke = stroke(slot, Color3.fromRGB(255, 255, 255), 1, 0.9)
		local slotScale = makeScale(slot, 1)

		local slotGrad = gradient(
			slot,
			Color3.fromRGB(26, 26, 34),
			Color3.fromRGB(78, 78, 90),
			90
		)

		local icon = Instance.new("ImageLabel")
		icon.Name = "Icon"
		icon.Size = UDim2.new(0, 54, 0, 54)
		icon.Position = UDim2.new(0.5, -27, 0, 7)
		icon.BackgroundTransparency = 1
		icon.Image = "rbxassetid://" .. tostring(data.Icon)
		icon.Parent = slot

		local iconScale = makeScale(icon, 1)

		local text = Instance.new("TextLabel")
		text.Size = UDim2.new(1, -6, 0, 18)
		text.Position = UDim2.new(0, 3, 1, -19)
		text.BackgroundTransparency = 1
		text.Text = data.Name
		text.TextColor3 = Color3.fromRGB(255, 255, 255)
		text.Font = Enum.Font.GothamMedium
		text.TextSize = 13
		text.TextWrapped = true
		text.Parent = slot

		local star = Instance.new("TextButton")
		star.Name = "FavButton"
		star.Size = UDim2.new(0, 18, 0, 18)
		star.Position = UDim2.new(1, -20, 0, 2)
		star.BackgroundTransparency = 1
		star.Text = favorites[data.Name] and "★" or "☆"
		star.TextColor3 = favorites[data.Name] and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(160, 160, 160)
		star.Font = Enum.Font.GothamBold
		star.TextSize = 16
		star.AutoButtonColor = false
		star.Parent = slot

		local starScale = makeScale(star, 1)

		slot.MouseEnter:Connect(function()
			tween(slotScale, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1.04 })
			tween(iconScale, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1.06 })
			tween(slotStroke, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = 0.55 })
			tween(slot, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 0 })
		end)

		slot.MouseLeave:Connect(function()
			tween(slotScale, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 })
			tween(iconScale, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 })
			tween(slotStroke, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = 0.9 })
			tween(slot, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 0.06 })
		end)

		slot.MouseButton1Click:Connect(function()
			safePlay(clickSound)
			tween(slotScale, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 0.97 })
			task.delay(0.09, function()
				if slot and slot.Parent then
					tween(slotScale, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1.04 })
				end
			end)

			if data.Logic == "Execute" then
				pcall(function()
					if loadstring and game.HttpGet then
						loadstring(game:HttpGet(data.Script))()
					end
				end)
			elseif data.Logic == "Copy" then
				pcall(function()
					setclipboard(data.Script)
				end)
			end
		end)

		star.MouseEnter:Connect(function()
			tween(starScale, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1.15 })
		end)

		star.MouseLeave:Connect(function()
			tween(starScale, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 })
		end)

		star.MouseButton1Click:Connect(function()
			safePlay(clickSound)

			favorites[data.Name] = not favorites[data.Name]
			saveFavorites()

			refreshFavoriteVisual(data.Name)

			for _, obj in ipairs(tabs["Favorites ⭐"].page:GetChildren()) do
				if obj:IsA("TextButton") and obj.Name == data.Name then
					obj:Destroy()
				end
			end

			if favorites[data.Name] then
				buildSlot(tabs["Favorites ⭐"].page)
			end

			updateEmptyState()
		end)
	end

	if favorites[data.Name] then
		buildSlot(tabs["Favorites ⭐"].page)
	end

	buildSlot(tabs[data.Tab].page)
	table.insert(allSlots, data)
	updatePageCanvas(tabs[data.Tab].page, tabs[data.Tab].grid)
	updatePageCanvas(tabs["Favorites ⭐"].page, tabs["Favorites ⭐"].grid)
	updateEmptyState()
end

--------------------------------------------------
-- SEARCH FILTER
--------------------------------------------------
local function applySearch()
	local txt = string.lower(search.Text or "")

	for _, tabData in pairs(tabs) do
		for _, slot in ipairs(tabData.page:GetChildren()) do
			if slot:IsA("TextButton") then
				if txt == "" then
					slot.Visible = true
				else
					slot.Visible = string.find(string.lower(slot.Name), txt, 1, true) ~= nil
				end
			end
		end
	end

	updateEmptyState()
end

search:GetPropertyChangedSignal("Text"):Connect(applySearch)

--------------------------------------------------
-- DRAGGING
--------------------------------------------------
do
	local dragging = false
	local dragInput
	local dragStart
	local startPos

	dragBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPos = main.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	dragBar.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			main.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

--------------------------------------------------
-- OPEN / CLOSE
--------------------------------------------------
local function openGui()
	if guiOpen then return end
	guiOpen = true
	main.Visible = true
	main.Position = UDim2.new(0.5, -235, 0.5, -195)
	mainScale.Scale = 0.96
	main.BackgroundTransparency = 0.12
	tween(mainScale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 })
	tween(main, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 0.05 })
end

local function closeGui()
	if not guiOpen then return end
	guiOpen = false
	local t1 = tween(mainScale, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.96 })
	local t2 = tween(main, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 0.12 })
	t1.Completed:Wait()
	if not guiOpen then
		main.Visible = false
	end
end

toggle.MouseButton1Click:Connect(function()
	safePlay(clickSound)
	if guiOpen then
		closeGui()
	else
		openGui()
	end
end)

closeBtn.MouseButton1Click:Connect(function()
	safePlay(clickSound)
	closeGui()
end)

--------------------------------------------------
-- HOLD 10s TO DELETE GUI
--------------------------------------------------
local holding = false

toggle.MouseButton1Down:Connect(function()
	holding = true
	task.spawn(function()
		local start = tick()
		while holding do
			if tick() - start >= 10 then
				gui:Destroy()
				break
			end
			task.wait()
		end
	end)
end)

toggle.MouseButton1Up:Connect(function()
	holding = false
end)

--------------------------------------------------
-- KEYBIND
--------------------------------------------------
UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.I then
		safePlay(clickSound)
		if guiOpen then
			closeGui()
		else
			openGui()
		end
	end
end)

