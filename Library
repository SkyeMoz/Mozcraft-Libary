local notifCount    = 0
local activeNotifs  = 0
local MAX_NOTIFS    = 4

local function notify(title, message, ntype, duration)
	-- Evict oldest if at cap
	if activeNotifs >= MAX_NOTIFS then
		local children = notifContainer:GetChildren()
		for _, c in ipairs(children) do
			if c:IsA("Frame") then
				pcall(function() c:Destroy() end)
				activeNotifs = math.max(0, activeNotifs - 1)
				break
			end
		end
	end

	notifCount  += 1
	activeNotifs += 1
	duration = math.max(duration or 3.5, 0.5)
	ntype    = ntype or "info"

	local accentCol = (ntype == "success" and THEME.SUCCESS)
		or (ntype == "error"   and THEME.ERROR)
		or (ntype == "warning" and Color3.fromRGB(255, 200, 0))
		or THEME.ACCENT

	local wrapper = makeFrame{
		Name                   = "Notif_" .. notifCount,
		Size                   = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
		ClipsDescendants       = true,
		ZIndex                 = 100,
		LayoutOrder            = notifCount,
		Parent                 = notifContainer,
	}
	local card = makeFrame{
		Size                   = UDim2.new(1, 0, 0, 58),
		Position               = UDim2.new(1, 0, 0, 0),  -- start off-screen right
		BackgroundColor3       = THEME.BG_ELEVATED,
		BackgroundTransparency = 0.05,
		ClipsDescendants       = true,
		ZIndex                 = 100,
		Parent                 = wrapper,
	}
	corner(card, 9)
	stroke(card, accentCol, 1, 0.5)

	-- accent left bar
	makeFrame{
		Size             = UDim2.new(0, 3, 1, 0),
		BackgroundColor3 = accentCol,
		ZIndex           = 101,
		Parent           = card,
	}
	-- icon
	makeLabel{
		Size       = UDim2.new(0, 18, 0, 18),
		Position   = UDim2.new(0, 11, 0.5, -9),
		Text       = (ntype == "success" and "✓") or (ntype == "error" and "✕")
			or (ntype == "warning" and "⚠") or "ℹ",
		TextColor3 = accentCol,
		TextSize   = 14,
		Font       = Enum.Font.GothamBold,
		ZIndex     = 101,
		Parent     = card,
	}
	makeLabel{
		Size           = UDim2.new(1, -50, 0, 16),
		Position       = UDim2.new(0, 40, 0, 7),
		Text           = title,
		TextColor3     = THEME.TEXT_PRIMARY,
		Font           = Enum.Font.GothamBold,
		TextSize       = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex         = 101,
		Parent         = card,
	}
	makeLabel{
		Size           = UDim2.new(1, -50, 0, 26),
		Position       = UDim2.new(0, 40, 0, 24),
		Text           = message,
		TextColor3     = THEME.TEXT_SECONDARY,
		TextSize       = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped    = true,
		ZIndex         = 101,
		Parent         = card,
	}
	local progress = makeFrame{
		Size             = UDim2.new(1, 0, 0, 2),
		Position         = UDim2.new(0, 0, 1, -2),
		BackgroundColor3 = accentCol,
		ZIndex           = 102,
		Parent           = card,
	}

	-- Slide in: expand wrapper height, then slide card from right
	safeTween(wrapper, TI.notif, {Size = UDim2.new(1, 0, 0, 58 + 5)})
	safeTween(card,    TI.notif, {Position = UDim2.new(0, 0, 0, 0)})
	safeTween(progress, TweenInfo.new(duration, Enum.EasingStyle.Linear),
		{Size = UDim2.new(0, 0, 0, 2)})

	task.delay(duration, function()
		if not wrapper or not wrapper.Parent then
			activeNotifs = math.max(0, activeNotifs - 1)
			return
		end
		-- Slide out right, then collapse height
		safeTween(card,    TI.minimize, {Position = UDim2.new(1, 10, 0, 0)})
		safeTween(card,    TI.minimize, {BackgroundTransparency = 1})
		task.wait(TI.minimize.Time)
		safeTween(wrapper, TI.minimize, {Size = UDim2.new(1, 0, 0, 0)})
		task.wait(TI.minimize.Time + 0.05)
		pcall(function()
			if wrapper and wrapper.Parent then wrapper:Destroy() end
			activeNotifs = math.max(0, activeNotifs - 1)
		end)
	end)
end

