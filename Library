local execHistory = safeRead(HIST_FILE)
local recentList  = {} -- recently used slot names, max 10

local function recordHistory(name, logic)
	table.insert(execHistory, 1, {
		name   = name,
		logic  = logic,
		time   = os.time(),
	})
	if #execHistory > 50 then
		table.remove(execHistory, #execHistory)
	end
	safeWrite(HIST_FILE, execHistory)

	-- recent
	for i, v in ipairs(recentList) do
		if v == name then table.remove(recentList, i) break end
	end
	table.insert(recentList, 1, name)
	if #recentList > 10 then table.remove(recentList, #recentList) end
end

