-- ║   VIEWPORT SCALE SYSTEM  ║
-- ║  PC=100% Tab=90% Mob=80% ║
-- ╚══════════════════════════╝
-- Base (unscaled) window dimensions
local BASE_W = 380
local BASE_H = 310

local function getViewport()
	return workspace.CurrentCamera.ViewportSize
end

-- Returns a uniform scale factor based on viewport width
local function getScale()
	local vp = getViewport()
	if vp.X < 700 then
		return 0.72
	elseif vp.X < 900 then
		return 0.80
	else
		return 1.0
	end
end

local function calcWindowSize()
	local s = getScale()
	return math.floor(BASE_W * s), math.floor(BASE_H * s)
end

local WIN_W, WIN_H = calcWindowSize()

-- ╔══════════════════════════╗
-- ║   TWEEN TRACKER          ║
-- ╚══════════════════════════╝
local activeTweens = {}

local function safeTween(obj, info, props)
	if not obj or not obj.Parent then return nil end
	local ok, t = pcall(TweenService.Create, TweenService, obj, info, props)
	if not ok or not t then return nil end
	activeTweens[t] = true
	t.Completed:Connect(function() activeTweens[t] = nil end)
	t:Play()
	return t
end

local function cancelAllTweens()
	for t in pairs(activeTweens) do pcall(function() t:Cancel() end) end
	table.clear(activeTweens)
end

