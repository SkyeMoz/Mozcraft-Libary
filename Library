local function makeFrame(parent, size, pos, color, zi)
    local f = Instance.new("Frame")
    f.Size             = size
    f.Position         = pos or UDim2.new(0,0,0,0)
    f.BackgroundColor3 = color or C.BG
    f.BorderSizePixel  = 0
    if zi then f.ZIndex = zi end
    f.Parent = parent
    return f
end

local function makeLabel(parent, text, size, pos, font, fs, color, xAlign, zi)
    local l = Instance.new("TextLabel")
    l.Text             = text or ""
    l.Size             = size
    l.Position         = pos or UDim2.new(0,0,0,0)
    l.BackgroundTransparency = 1
    l.Font             = font or FONT
    l.TextSize         = fs or R.FONT_SIZE
    l.TextColor3       = color or C.TEXT_DARK
    l.TextXAlignment   = xAlign or Enum.TextXAlignment.Left
    l.TextYAlignment   = Enum.TextYAlignment.Center
    l.TextTruncate     = Enum.TextTruncate.AtEnd
    if zi then l.ZIndex = zi end
    l.Parent = parent
    return l
end

local function makeButton(parent, size, pos, color, zi)
    local b = Instance.new("TextButton")
    b.Size             = size
    b.Position         = pos or UDim2.new(0,0,0,0)
    b.BackgroundColor3 = color or C.BG
    b.BorderSizePixel  = 0
    b.Text             = ""
    b.AutoButtonColor  = false
    if zi then b.ZIndex = zi end
    b.Parent = parent
    return b
end

local function makeImage(parent, id, size, pos, zi)
    local i = Instance.new("ImageLabel")
    i.Size             = size
    i.Position         = pos or UDim2.new(0,0,0,0)
    i.BackgroundTransparency = 1
    i.Image            = id and ("rbxassetid://"..tostring(id)) or ""
    i.ScaleType        = Enum.ScaleType.Fit
    if zi then i.ZIndex = zi end
    i.Parent = parent
    return i
end

-- Bedrock-style inset bevel (slot looks sunken)
local function addInsetBevel(frame, zi)
    zi = zi or (frame.ZIndex + 1)
    local t = makeFrame(frame, UDim2.new(1,0,0,2), UDim2.new(0,0,0,0), C.DARK, zi)
    local l = makeFrame(frame, UDim2.new(0,2,1,0), UDim2.new(0,0,0,0), C.DARK, zi)
    local b = makeFrame(frame, UDim2.new(1,0,0,2), UDim2.new(0,0,1,-2), C.LIGHT, zi)
    b.BackgroundTransparency = 0.5
    local r = makeFrame(frame, UDim2.new(0,2,1,0), UDim2.new(1,-2,0,0), C.LIGHT, zi)
    r.BackgroundTransparency = 0.5
    return t, l, b, r
end

-- Bedrock-style raised bevel (button)
local function addRaisedBevel(frame, zi)
    zi = zi or (frame.ZIndex + 1)
    local t = makeFrame(frame, UDim2.new(1,0,0,2), UDim2.new(0,0,0,0), C.LIGHT, zi)
    t.BackgroundTransparency = 0.4
    local l = makeFrame(frame, UDim2.new(0,2,1,0), UDim2.new(0,0,0,0), C.LIGHT, zi)
    l.BackgroundTransparency = 0.4
    local b = makeFrame(frame, UDim2.new(1,0,0,2), UDim2.new(0,0,1,-2), C.DARK, zi)
    local r = makeFrame(frame, UDim2.new(0,2,1,0), UDim2.new(1,-2,0,0), C.DARK, zi)
    return t, l, b, r
end

local function addCornerRadius(parent, px)
    local u = Instance.new("UICorner")
    u.CornerRadius = UDim.new(0, px or 4)
    u.Parent = parent
    return u
end

