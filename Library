local function updateTabCanvas()
	task.defer(function()
		tabScroll.CanvasSize = UDim2.new(0, tabLayout.AbsoluteContentSize.X + 8, 0, 0)
	end)
end

local function updatePageCanvas(page, grid)
	task.defer(function()
		page.CanvasSize = UDim2.new(0, 0, 0, grid.AbsoluteContentSize.Y + 12)
	end)
end

local function refreshFavoriteVisual(name)
	for _, tabData in pairs(tabs) do
		for _, obj in ipairs(tabData.page:GetChildren()) do
			if obj:IsA("TextButton") and obj.Name == name then
				local favBtn = obj:FindFirstChild("FavButton")
				if favBtn and favBtn:IsA("TextButton") then
					local isFav = favorites[name] == true
					favBtn.Text = isFav and "★" or "☆"
					favBtn.TextColor3 = isFav and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(160, 160, 160)
				end
			end
		end
	end
end

local function countVisibleSlots(page)
	local count = 0
	for _, obj in ipairs(page:GetChildren()) do
		if obj:IsA("TextButton") and obj.Visible then
			count += 1
		end
	end
	return count
end

local function updateEmptyState()
	if not currentTabName or not tabs[currentTabName] then
		activeLabel.Visible = true
		activeLabel.Text = "🟢 Active Service"
		return
	end

	local page = tabs[currentTabName].page
	local visibleCount = countVisibleSlots(page)

	if visibleCount <= 0 then
		activeLabel.Visible = true
		if currentTabName == "Favorites ⭐" then
			activeLabel.Text = "⭐ No favorites yet"
			activeLabel.TextColor3 = Color3.fromRGB(255, 205, 60)
		else
			activeLabel.Text = "No results found"
			activeLabel.TextColor3 = Color3.fromRGB(240, 240, 240)
		end
	else
		activeLabel.Visible = false
	end
end

local function slideHighlightTo(btn)
	local relativeX = btn.AbsolutePosition.X - tabOverlay.AbsolutePosition.X
	local relativeY = btn.AbsolutePosition.Y - tabOverlay.AbsolutePosition.Y
	tween(highlight, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.new(0, relativeX, 0, relativeY),
		Size = UDim2.new(0, btn.AbsoluteSize.X, 0, btn.AbsoluteSize.Y),
	})
end

local function selectTab(name)
	if not tabs[name] then return end

	currentTabName = name
	activeLabel.Visible = false

	for tabName, tabData in pairs(tabs) do
		tabData.page.Visible = (tabName == name)
	end

	slideHighlightTo(tabs[name].button)
	updateEmptyState()
end

